---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import AuthorBio from '../components/AuthorBio.astro';
import FormattedDate from '../components/FormattedDate.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import PostCard from '../components/PostCard.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LessonContext from '../components/LessonContext.astro';
import LessonNavigator from '../components/LessonNavigator.astro';
import ProjectCallout from '../components/ProjectCallout.astro';
import ArticleToc from '../components/ArticleToc.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import {
  SITE_URL,
  SITE_TITLE,
  AUTHOR_NAME,
  AUTHOR_URL,
  AUTHOR_SHORT_NAME,
  AUTHOR_ROLE,
  AUTHOR_LINKEDIN_URL,
  AUTHOR_X_URL,
  AUTHOR_BLUESKY_URL,
  AUTHOR_GITHUB_URL,
  CODECRAFTMD_URL,
  OPENMFM_URL,
  ORGANIZATION_LOGO,
} from '../consts';
import { slugifyTag } from '../utils/tags';
import { getLearningContextForArticle } from '../utils/learning';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  authorUrl?: string;
  tags?: string[];
  category?: string;
  image?: { url: string; alt: string };
  ogImage?: string;
  readingTime?: number;
  wordCount?: number;
  canonical?: string;
  headings?: { depth: number; slug: string; text: string }[];
  audioUrl?: string;
  noIndex?: boolean;
}

const postSlug = Astro.url.pathname.replace(/^\/blog\//, '').replace(/\/$/, '');

const {
  title,
  description,
  pubDate,
  updatedDate,
  author = AUTHOR_NAME,
  authorUrl = AUTHOR_URL,
  tags = [],
  category = 'Technology',
  image,
  ogImage = `/og/${postSlug}.png`,
  readingTime,
  wordCount,
  canonical = Astro.url.href,
  headings = [],
  audioUrl,
  noIndex = false,
} = Astro.props;

const learningContext = await getLearningContextForArticle(postSlug);
const lessonContext = learningContext?.course && learningContext.path ? learningContext : undefined;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  inLanguage: 'en-US',
  articleSection: category,
  keywords: tags.join(', '),
  wordCount,
  timeRequired: readingTime ? `PT${readingTime}M` : undefined,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonical,
  },
  isPartOf: {
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
  },
  author: {
    '@type': 'Person',
    '@id': `${SITE_URL}/chukwuma-onyeije#person`,
    name: AUTHOR_SHORT_NAME,
    honorificPrefix: 'Dr.',
    honorificSuffix: 'MD, FACOG',
    url: AUTHOR_URL,
    jobTitle: AUTHOR_ROLE,
    sameAs: [AUTHOR_LINKEDIN_URL, AUTHOR_X_URL, AUTHOR_BLUESKY_URL, AUTHOR_GITHUB_URL, CODECRAFTMD_URL, OPENMFM_URL],
    worksFor: {
      '@type': 'MedicalOrganization',
      name: 'Atlanta Perinatal Associates',
    },
  },
  publisher: {
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    name: SITE_TITLE,
    url: SITE_URL,
    logo: {
      '@type': 'ImageObject',
      url: `${SITE_URL}${ORGANIZATION_LOGO}`,
    },
  },
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  image: image?.url ? (image.url.startsWith('http') ? image.url : `${SITE_URL}${image.url}`) : (ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`),
  about: tags.map((tag) => ({
    '@type': 'Thing',
    name: tag,
  })),
  url: canonical,
};

const learningSchemas = lessonContext ? [
  {
    '@context': 'https://schema.org',
    '@type': 'LearningResource',
    name: lessonContext.lesson.data.title,
    description: lessonContext.lesson.data.description,
    educationalLevel: lessonContext.lesson.data.difficulty,
    timeRequired: `PT${lessonContext.lesson.data.estimatedMinutes}M`,
    isPartOf: {
      '@type': 'Course',
      name: lessonContext.course.data.title,
      url: `${SITE_URL}/courses/${lessonContext.course.id}/`,
    },
    url: canonical,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Learning Paths', item: `${SITE_URL}/paths/` },
      { '@type': 'ListItem', position: 3, name: lessonContext.path.data.title, item: `${SITE_URL}/paths/${lessonContext.path.id}/` },
      { '@type': 'ListItem', position: 4, name: lessonContext.course.data.title, item: `${SITE_URL}/courses/${lessonContext.course.id}/` },
      { '@type': 'ListItem', position: 5, name: lessonContext.lesson.data.title, item: canonical },
    ],
  },
] : [];
const pageSchemas = [articleSchema, ...learningSchemas];

// Only show TOC if there are headings at depth 2 or 3
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);

// Related posts: match by shared tags, exclude current post
const currentSlug = Astro.url.pathname.replace(/^\/blog\//, '').replace(/\/$/, '');
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const relatedPosts = allPosts
  .filter(p => p.id !== currentSlug && p.data.tags?.some(t => tags.includes(t)))
  .sort((a, b) => {
    const sharedA = a.data.tags.filter(t => tags.includes(t)).length;
    const sharedB = b.data.tags.filter(t => tags.includes(t)).length;
    return sharedB - sharedA || b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  })
  .slice(0, 3);
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  ogType="article"
  pubDate={pubDate}
  updatedDate={updatedDate}
  articleSchema={pageSchemas}
  noIndex={noIndex}
>
  <ReadingProgress />
  <div class="post-shell">

    <!-- Main post content -->
    <article aria-labelledby="article-title">
      {lessonContext && (
        <Breadcrumbs items={[
          { label: 'Home', href: '/' },
          { label: 'Learning Paths', href: '/paths/' },
          { label: lessonContext.path.data.title, href: `/paths/${lessonContext.path.id}/` },
          { label: lessonContext.course.data.title, href: `/courses/${lessonContext.course.id}/` },
          { label: lessonContext.lesson.data.title },
        ]} />
      )}

      <!-- Category + reading time -->
      <div class="post-kicker-row">
        {lessonContext ? (
          <>
            <a class="label post-learning-link" href={`/paths/${lessonContext.path.id}/`}>{lessonContext.path.data.title}</a>
            <a class="eyebrow-copy post-learning-link" href={`/courses/${lessonContext.course.id}/`}>{lessonContext.course.data.title}</a>
            <span class="eyebrow-copy">Lesson {lessonContext.lesson.data.lessonNumber} of {lessonContext.courseLessons.length}</span>
            <span class="difficulty-badge">{lessonContext.lesson.data.difficulty}</span>
          </>
        ) : (
          <span class="label">{category}</span>
        )}
        {readingTime && (
          <span class="eyebrow-copy">{readingTime} min read</span>
        )}
      </div>

      <!-- Title -->
      <h1 id="article-title" class="gradient-text post-title">{title}</h1>

      <!-- Description -->
      <p class="lede-copy post-description">{description}</p>

      <!-- Compact article byline -->
      <div class="post-author-panel">
        <p class="post-author-name">
          By <a href="/chukwuma-onyeije" class="post-author-name-link">Dr. Chukwuma Onyeije, MD, FACOG</a>
        </p>
        <p class="post-author-meta">
          <span>Maternal-Fetal Medicine</span>
          <span class="post-author-sep">&middot;</span>
          <span><FormattedDate date={pubDate} /></span>
          {readingTime && (
            <>
              <span class="post-author-sep">&middot;</span>
              <span>{readingTime} min read</span>
            </>
          )}
        </p>
      </div>

      {lessonContext && (
        <LessonContext
          lesson={lessonContext.lesson}
          course={lessonContext.course}
          path={lessonContext.path}
        />
      )}

      <!-- Audio player -->
      {audioUrl && <AudioPlayer src={audioUrl} title={title} />}

      <!-- Featured image -->
      {image && (
        <img
          src={image.url}
          alt={image.alt}
          class="post-feature-image"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      )}

      {tocHeadings.length > 0 && <ArticleToc headings={tocHeadings} mobile />}

      <!-- Post body -->
      <div class="prose">
        <slot />
      </div>

      {lessonContext?.project && (
        <ProjectCallout project={lessonContext.project} headingLevel="h2" compact />
      )}

      {lessonContext && (
        <LessonNavigator
          course={lessonContext.course}
          lessons={lessonContext.courseLessons}
          currentLesson={lessonContext.lesson}
        />
      )}

      <!-- Tags -->
      {tags.length > 0 && (
        <nav class="post-tag-row" aria-label="Article topics">
          {tags.map(tag => (
            <a
              href={`/tags/${slugifyTag(tag)}`}
              class="tag-pill"
            >
              {tag}
            </a>
          ))}
        </nav>
      )}

      <!-- Share links -->
      <section class="post-share-row" aria-labelledby="share-heading">
        <h2 id="share-heading" class="sr-only">Share this article</h2>
        <span class="label">Share</span>
        <a
          href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(canonical)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="post-share-link"
        >X / Twitter</a>
        <a
          href={`https://bsky.app/intent/compose?text=${encodeURIComponent(title + ' ' + canonical)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="post-share-link"
        >Bluesky</a>
        <a
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonical)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="post-share-link"
        >LinkedIn</a>
        <button
          id="copy-link-btn"
          data-url={canonical}
          class="post-share-link post-share-button"
        >Copy link</button>
        <span id="copy-link-status" class="sr-only" aria-live="polite"></span>
      </section>

      <!-- Newsletter -->
      <div style="margin-top: 3rem;">
        <NewsletterForm
          title="Continue building."
          subtitle="Get physician-developer insights delivered weekly. No hype. No filler."
          compact
        />
      </div>

      <!-- Related posts -->
      {relatedPosts.length > 0 && (
        <section class="post-section" aria-labelledby="related-articles-heading">
          <h2 id="related-articles-heading" class="post-section-title">Related articles</h2>
          <div class="post-related-grid">
            {relatedPosts.map(post => (
              <PostCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                slug={post.id}
                tags={post.data.tags}
                category={post.data.category}
                readingTime={post.data.readingTime}
                image={post.data.image}
                featured={post.data.featured}
              />
            ))}
          </div>
        </section>
      )}

      <!-- Author bio -->
      <div style="margin-top: 3rem;">
        <AuthorBio />
      </div>
    </article>

    <!-- Sidebar TOC -->
    <aside class="post-sidebar">
      {tocHeadings.length > 0 && (
        <ArticleToc headings={tocHeadings} />
      )}
    </aside>

  </div>
</BaseLayout>

<script>
  const btn = document.getElementById('copy-link-btn');
  const copyStatus = document.getElementById('copy-link-status');
  btn?.addEventListener('click', async () => {
    const url = btn.getAttribute('data-url') ?? window.location.href;
    try {
      await navigator.clipboard.writeText(url);
      btn.textContent = 'Copied';
      btn.setAttribute('data-copied', 'true');
      if (copyStatus) copyStatus.textContent = 'Article link copied to clipboard.';
      setTimeout(() => {
        btn.textContent = 'Copy link';
        btn.removeAttribute('data-copied');
        if (copyStatus) copyStatus.textContent = '';
      }, 2000);
    } catch {
      if (copyStatus) copyStatus.textContent = 'The link could not be copied. Copy it from the address bar.';
    }
  });
</script>

<style>
  .post-shell {
    max-width: 1160px;
    margin: 0 auto;
    padding: var(--space-page-y) var(--space-page-x);
    display: grid;
    grid-template-columns: minmax(0, 760px) minmax(220px, 260px);
    gap: clamp(2rem, 1.4rem + 3vw, 4rem);
    align-items: start;
  }

  article {
    min-width: 0;
  }

  .post-kicker-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-bottom: 1.25rem;
  }

  .post-learning-link:hover {
    color: var(--dwc-white);
  }

  .difficulty-badge {
    padding: 0.22rem 0.55rem;
    border: 1px solid rgba(56, 189, 248, 0.35);
    border-radius: 999px;
    color: var(--dwc-cyan);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: capitalize;
  }

  .post-title {
    margin-bottom: 1rem;
    max-width: 19ch;
    font-size: clamp(2.15rem, 1.45rem + 2.4vw, 3.25rem);
  }

  .post-description {
    margin-bottom: 1.5rem;
    max-width: 60ch;
  }

  .post-author-panel {
    margin-bottom: 1.75rem;
    padding: 0.9rem 0;
    border-top: 1px solid var(--dwc-border);
    border-bottom: 1px solid var(--dwc-border);
  }

  .post-author-name {
    margin: 0 0 0.35rem;
    font-size: clamp(0.98rem, 0.94rem + 0.22vw, 1.02rem);
    font-weight: 600;
  }

  .post-author-name-link {
    color: inherit;
    text-decoration: none;
  }

  .post-author-meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.75rem;
    align-items: center;
    font-family: var(--font-mono);
    font-size: clamp(0.78rem, 0.75rem + 0.16vw, 0.84rem);
    line-height: 1.55;
    color: var(--dwc-muted);
  }

  .post-author-sep {
    color: var(--dwc-border);
  }

  .post-feature-image {
    width: 100%;
    border-radius: 12px;
    margin-bottom: 2rem;
    border: 1px solid var(--dwc-border);
  }

  .post-tag-row,
  .post-share-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--dwc-border);
  }

  .post-tag-row {
    margin-top: 2.5rem;
  }

  .post-share-row {
    align-items: center;
  }

  .post-share-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--dwc-border);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: clamp(0.8rem, 0.77rem + 0.16vw, 0.85rem);
    line-height: 1.2;
    color: var(--dwc-muted);
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s;
  }

  .post-share-button {
    background: none;
    cursor: pointer;
  }

  .post-share-button[data-copied] {
    color: var(--dwc-cyan);
    border-color: var(--dwc-cyan);
  }

  .post-section {
    margin-top: 3rem;
  }

  .post-section-title {
    margin-bottom: 1.25rem;
    font-size: clamp(1.35rem, 1.18rem + 0.7vw, 1.65rem);
  }

  .post-related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .post-sidebar {
    position: sticky;
    top: 84px;
  }

  @media (max-width: 900px) {
    .post-shell {
      grid-template-columns: 1fr;
    }

    .post-sidebar {
      display: none;
    }
  }

  @media (max-width: 540px) {
    .post-share-link {
      flex: 1 1 calc(50% - 0.5rem);
    }

    .post-share-row > .label {
      width: 100%;
    }
  }

  @media (max-width: 420px) {
    .post-share-link {
      flex-basis: 100%;
    }
  }
</style>
