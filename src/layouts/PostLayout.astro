---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import AuthorBio from '../components/AuthorBio.astro';
import FormattedDate from '../components/FormattedDate.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import PostCard from '../components/PostCard.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import { SITE_URL, AUTHOR_NAME, AUTHOR_URL, SITE_TITLE } from '../consts';
import { slugifyTag } from '../utils/tags';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  authorUrl?: string;
  tags?: string[];
  category?: string;
  image?: { url: string; alt: string };
  ogImage?: string;
  readingTime?: number;
  canonical?: string;
  headings?: { depth: number; slug: string; text: string }[];
  audioUrl?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  author = AUTHOR_NAME,
  authorUrl = AUTHOR_URL,
  tags = [],
  category = 'Technology',
  image,
  ogImage = image?.url ?? '/images/og-default.jpg',
  readingTime,
  canonical = Astro.url.href,
  headings = [],
  audioUrl,
} = Astro.props;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "author": {
    "@type": "Person",
    "name": author,
    "url": authorUrl,
    "jobTitle": "Maternal-Fetal Medicine Specialist",
    "worksFor": {
      "@type": "Organization",
      "name": "Atlanta Perinatal Associates"
    }
  },
  "publisher": {
    "@type": "Organization",
    "name": SITE_TITLE,
    "url": SITE_URL
  },
  "datePublished": pubDate.toISOString(),
  "dateModified": (updatedDate ?? pubDate).toISOString(),
  "image": ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`,
  "url": canonical,
};

// Only show TOC if there are headings at depth 2 or 3
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);

// Related posts: match by shared tags, exclude current post
const currentSlug = Astro.url.pathname.replace(/^\/blog\//, '').replace(/\/$/, '');
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const relatedPosts = allPosts
  .filter(p => p.id !== currentSlug && p.data.tags?.some(t => tags.includes(t)))
  .sort((a, b) => {
    const sharedA = a.data.tags.filter(t => tags.includes(t)).length;
    const sharedB = b.data.tags.filter(t => tags.includes(t)).length;
    return sharedB - sharedA || b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  })
  .slice(0, 3);
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  ogType="article"
  pubDate={pubDate}
  updatedDate={updatedDate}
  articleSchema={articleSchema}
>
  <div class="post-shell">

    <!-- Main post content -->
    <article>
      <!-- Category + reading time -->
      <div class="post-kicker-row">
        <span class="label">{category}</span>
        {readingTime && (
          <span class="eyebrow-copy">{readingTime} min read</span>
        )}
      </div>

      <!-- Title -->
      <h1 class="gradient-text post-title">{title}</h1>

      <!-- Description -->
      <p class="lede-copy post-description">{description}</p>

      <!-- Enhanced author block -->
      <div class="post-author-panel">
        <p class="post-author-name">
          By Dr. Chukwuma Onyeije, MD, FACOG
        </p>
        <p class="post-author-role">
          Maternal-Fetal Medicine Specialist &amp; Medical Director, Atlanta Perinatal Associates
        </p>
        <p class="post-author-meta">
          <span>Founder, Doctors Who Code &middot; OpenMFM.org &middot; CodeCraftMD</span>
          <span class="post-author-sep">&middot;</span>
          <span><FormattedDate date={pubDate} /></span>
          {readingTime && (
            <>
              <span class="post-author-sep">&middot;</span>
              <span>{readingTime} min read</span>
            </>
          )}
        </p>
      </div>

      <!-- Audio player -->
      {audioUrl && <AudioPlayer src={audioUrl} title={title} />}

      <!-- Featured image -->
      {image && (
        <img
          src={image.url}
          alt={image.alt}
          class="post-feature-image"
        />
      )}

      <!-- Post body -->
      <div class="prose">
        <slot />
      </div>

      <!-- Tags -->
      {tags.length > 0 && (
        <div class="post-tag-row">
          {tags.map(tag => (
            <a
              href={`/tags/${slugifyTag(tag)}`}
              class="tag-pill"
            >
              {tag}
            </a>
          ))}
        </div>
      )}

      <!-- Share links -->
      <div class="post-share-row">
        <span class="label">Share</span>
        <a
          href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(canonical)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="post-share-link"
        >X / Twitter</a>
        <a
          href={`https://bsky.app/intent/compose?text=${encodeURIComponent(title + ' ' + canonical)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="post-share-link"
        >Bluesky</a>
        <a
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonical)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="post-share-link"
        >LinkedIn</a>
        <button
          id="copy-link-btn"
          data-url={canonical}
          class="post-share-link post-share-button"
        >Copy link</button>
      </div>

      <!-- Newsletter -->
      <div style="margin-top: 3rem;">
        <NewsletterForm
          title="Enjoyed this post?"
          subtitle="Get physician-developer insights delivered weekly. No hype. No filler."
        />
      </div>

      <!-- Related posts -->
      {relatedPosts.length > 0 && (
        <div class="post-section">
          <p class="label" style="margin-bottom: 1.25rem;">Related Posts</p>
          <div class="post-related-grid">
            {relatedPosts.map(post => (
              <PostCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                slug={post.id}
                tags={post.data.tags}
                category={post.data.category}
                readingTime={post.data.readingTime}
                image={post.data.image}
                featured={post.data.featured}
              />
            ))}
          </div>
        </div>
      )}

      <!-- Author bio -->
      <div style="margin-top: 3rem;">
        <AuthorBio />
      </div>
    </article>

    <!-- Sidebar TOC -->
    <aside class="post-sidebar">
      {tocHeadings.length > 0 && (
        <div class="post-toc-card">
          <p class="label" style="margin-bottom: 1rem;">On this page</p>
          <nav>
            <ul class="post-toc-list">
              {tocHeadings.map(h => (
                <li class:list={['post-toc-item', { 'post-toc-item--nested': h.depth === 3 }]}>
                  <a
                    href={`#${h.slug}`}
                    class="post-toc-link"
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      )}
    </aside>

  </div>
</BaseLayout>

<script>
  const btn = document.getElementById('copy-link-btn');
  btn?.addEventListener('click', async () => {
    const url = btn.getAttribute('data-url') ?? window.location.href;
    await navigator.clipboard.writeText(url);
    btn.textContent = 'Copied!';
    btn.style.color = 'var(--dwc-cyan)';
    btn.style.borderColor = 'var(--dwc-cyan)';
    setTimeout(() => {
      btn.textContent = 'Copy link';
      btn.style.color = '';
      btn.style.borderColor = '';
    }, 2000);
  });
</script>

<style>
  .post-shell {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-page-y) var(--space-page-x);
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: clamp(2rem, 1.4rem + 3vw, 4rem);
    align-items: start;
  }

  article {
    min-width: 0;
  }

  .post-kicker-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-bottom: 1.25rem;
  }

  .post-title {
    margin-bottom: 1rem;
    font-size: clamp(2rem, 1.45rem + 2vw, 2.5rem);
  }

  .post-description {
    margin-bottom: 1.5rem;
    max-width: 60ch;
  }

  .post-author-panel {
    margin-bottom: 2rem;
    padding: clamp(1rem, 0.8rem + 0.8vw, 1.5rem);
    background: var(--dwc-card);
    border: 1px solid var(--dwc-border);
    border-left: 3px solid;
    border-image: linear-gradient(to bottom, #a855f7, #38bdf8) 1;
    border-radius: 0 8px 8px 0;
  }

  .post-author-name {
    margin: 0 0 0.25rem;
    font-size: clamp(0.98rem, 0.94rem + 0.22vw, 1.02rem);
    font-weight: 600;
  }

  .post-author-role {
    margin: 0 0 0.6rem;
    font-size: var(--font-size-meta);
    line-height: 1.5;
    color: var(--dwc-muted);
  }

  .post-author-meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.75rem;
    align-items: center;
    font-family: var(--font-mono);
    font-size: clamp(0.78rem, 0.75rem + 0.16vw, 0.84rem);
    line-height: 1.55;
    color: var(--dwc-muted);
  }

  .post-author-sep {
    color: var(--dwc-border);
  }

  .post-feature-image {
    width: 100%;
    border-radius: 12px;
    margin-bottom: 2rem;
    border: 1px solid var(--dwc-border);
  }

  .post-tag-row,
  .post-share-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--dwc-border);
  }

  .post-tag-row {
    margin-top: 2.5rem;
  }

  .post-share-row {
    align-items: center;
  }

  .post-share-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--dwc-border);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: clamp(0.8rem, 0.77rem + 0.16vw, 0.85rem);
    line-height: 1.2;
    color: var(--dwc-muted);
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s;
  }

  .post-share-button {
    background: none;
    cursor: pointer;
  }

  .post-section {
    margin-top: 3rem;
  }

  .post-related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .post-sidebar {
    position: sticky;
    top: 84px;
  }

  .post-toc-card {
    background-color: var(--dwc-card);
    border: 1px solid var(--dwc-border);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .post-toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .post-toc-item--nested {
    padding-left: 1rem;
  }

  .post-toc-link {
    display: block;
    font-size: var(--font-size-meta);
    line-height: 1.45;
    color: var(--dwc-muted);
    transition: color 0.2s;
  }

  @media (max-width: 900px) {
    .post-shell {
      grid-template-columns: 1fr;
    }

    .post-sidebar {
      display: none;
    }
  }

  @media (max-width: 540px) {
    .post-share-link {
      flex: 1 1 calc(50% - 0.5rem);
    }

    .post-share-row > .label {
      width: 100%;
    }
  }

  @media (max-width: 420px) {
    .post-share-link {
      flex-basis: 100%;
    }
  }
</style>
