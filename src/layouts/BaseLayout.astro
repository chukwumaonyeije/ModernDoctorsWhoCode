---
import '../styles/global.css';
import { SITE_TITLE, SITE_URL, AUTHOR_NAME, TWITTER_HANDLE, OG_DEFAULT_IMAGE } from '../consts';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  pubDate?: Date;
  updatedDate?: Date;
  articleSchema?: object;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = OG_DEFAULT_IMAGE,
  ogType = 'website',
  pubDate,
  updatedDate,
  articleSchema,
} = Astro.props;

const fullTitle = `${title} | ${SITE_TITLE}`;
const ogImageAbsolute = ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR_NAME} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_TITLE} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content={TWITTER_HANDLE} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <!-- Dates for articles -->
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}

    <!-- Structured data -->
    {articleSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    )}

    <!-- Sitelinks searchbox for homepage -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": SITE_TITLE,
      "url": SITE_URL,
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": `${SITE_URL}/blog?q={search_term_string}`
        },
        "query-input": "required name=search_term_string"
      }
    })} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- RSS -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={`${SITE_URL}/rss.xml`}
    />

    <!-- Vercel Analytics -->
    <script defer src="/_vercel/insights/script.js"></script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <!-- Navigation -->
    <header class="site-header">
      <nav class="site-shell site-nav">
        <a href="/" class="site-nav-brand">
          <span class="live-dot"></span>
          Doctors Who Code
        </a>
        <div class="site-nav-links">
          <a href="/blog" class="site-nav-link">Blog</a>
          <a href="/about" class="site-nav-link">About</a>
          <a href="/contact" class="site-button site-button--primary site-nav-cta">Subscribe</a>
        </div>
      </nav>
    </header>

    <!-- Page content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="site-shell site-footer-grid">
        <div>
          <p class="site-footer-title">Doctors Who Code</p>
          <p class="site-footer-copy">Where medicine meets code.</p>
          <p class="site-footer-copy">Written by Chukwuma Onyeije, MD, FACOG</p>
        </div>
        <div>
          <p class="label" style="margin-bottom: 0.75rem;">Projects</p>
          <ul class="site-footer-list">
            <li><a href="https://codecraftmd.com" class="site-footer-link">CodeCraftMD</a></li>
            <li><a href="https://openmfm.org" class="site-footer-link">OpenMFM.org</a></li>
          </ul>
        </div>
        <div>
          <p class="label" style="margin-bottom: 0.75rem;">Connect</p>
          <ul class="site-footer-list">
            <li><a href="https://linkedin.com/in/chukwumaonyeije" class="site-footer-link">LinkedIn</a></li>
            <li><a href="https://x.com/chukwumaonyeije" class="site-footer-link">X / Twitter</a></li>
            <li><a href="/contact" class="site-footer-link">Newsletter</a></li>
          </ul>
        </div>
      </div>
      <div class="site-shell site-footer-bottom">
        <p class="site-footer-meta">
          &copy; {new Date().getFullYear()} Chukwuma Onyeije, MD, FACOG
        </p>
        <p class="site-footer-meta">
          <a href="/rss.xml" class="site-footer-link">RSS</a> &middot;
          <a href="/sitemap-index.xml" class="site-footer-link">Sitemap</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--dwc-border);
    background-color: rgba(13, 27, 42, 0.95);
    backdrop-filter: blur(8px);
  }

  .site-nav {
    min-height: 4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.7rem;
  }

  .site-nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.94rem + 0.4vw, 1.125rem);
    font-weight: 800;
    color: var(--dwc-white);
    line-height: 1.1;
  }

  .site-nav-links {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 0.3rem + 1.8vw, 2rem);
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .site-nav-link {
    font-size: clamp(0.92rem, 0.88rem + 0.16vw, 0.98rem);
    color: var(--dwc-muted);
    line-height: 1.3;
  }

  .site-nav-cta {
    min-height: 2.4rem;
    width: auto;
    padding-inline: 0.95rem;
  }

  .site-footer {
    border-top: 1px solid var(--dwc-border);
    margin-top: clamp(4rem, 3rem + 2vw, 5rem);
    padding-top: clamp(2.5rem, 2rem + 1vw, 3rem);
    padding-bottom: clamp(2rem, 1.5rem + 1vw, 2.5rem);
  }

  .site-footer-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .site-footer-title {
    margin-bottom: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.05rem);
    font-weight: 700;
    color: var(--dwc-white);
  }

  .site-footer-copy,
  .site-footer-link,
  .site-footer-meta {
    font-size: var(--font-size-meta);
    color: var(--dwc-muted);
  }

  .site-footer-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .site-footer-bottom {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--dwc-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .site-footer-meta {
    margin: 0;
    font-family: var(--font-mono);
    line-height: 1.5;
  }

  @media (max-width: 720px) {
    .site-nav {
      align-items: flex-start;
    }

    .site-nav-links {
      gap: 0.75rem;
    }

    .site-footer-grid {
      grid-template-columns: 1fr;
    }

    .site-footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 520px) {
    .site-nav {
      flex-direction: column;
      align-items: stretch;
    }

    .site-nav-links {
      width: 100%;
      justify-content: space-between;
    }

    .site-nav-cta {
      width: auto;
    }
  }
</style>
