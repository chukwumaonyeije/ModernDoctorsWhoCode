---
import '../styles/global.css';
import themeScript from '../scripts/theme.js?raw';
import Header from '../components/Header.astro';
import SiteFooter from '../components/SiteFooter.astro';
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  SITE_URL,
  AUTHOR_NAME,
  AUTHOR_SHORT_NAME,
  AUTHOR_ROLE,
  AUTHOR_LOCATION,
  AUTHOR_URL,
  AUTHOR_LINKEDIN_URL,
  AUTHOR_X_URL,
  AUTHOR_BLUESKY_URL,
  AUTHOR_GITHUB_URL,
  AUTHOR_EMORY_URL,
  AUTHOR_PIEDMONT_URL,
  AUTHOR_DOXIMITY_URL,
  CODECRAFTMD_URL,
  OPENMFM_URL,
  TWITTER_HANDLE,
  OG_DEFAULT_IMAGE,
  ORGANIZATION_LOGO,
} from '../consts';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  pubDate?: Date;
  updatedDate?: Date;
  articleSchema?: object | object[];
  noIndex?: boolean;
  includeSiteTitle?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = OG_DEFAULT_IMAGE,
  ogType = 'website',
  pubDate,
  updatedDate,
  articleSchema,
  noIndex = false,
  includeSiteTitle = true,
} = Astro.props;

const fullTitle = includeSiteTitle ? `${title} | ${SITE_TITLE}` : title;
const ogImageAbsolute = ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`;
const websiteId = `${SITE_URL}/#website`;
const organizationId = `${SITE_URL}/#organization`;
const personId = `${SITE_URL}/chukwuma-onyeije#person`;
const pageId = `${canonical}#webpage`;
const combinedSchemas = [
  {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebSite',
        '@id': websiteId,
        url: SITE_URL,
        name: SITE_TITLE,
        alternateName: 'DoctorsWhoCode.blog',
        description: SITE_DESCRIPTION,
        publisher: {
          '@id': organizationId,
        },
        about: {
          '@id': personId,
        },
        potentialAction: {
          '@type': 'SearchAction',
          target: {
            '@type': 'EntryPoint',
            urlTemplate: `${SITE_URL}/blog?q={search_term_string}`,
          },
          'query-input': 'required name=search_term_string',
        },
      },
      {
        '@type': 'Organization',
        '@id': organizationId,
        name: SITE_TITLE,
        url: SITE_URL,
        description: SITE_DESCRIPTION,
        founder: {
          '@id': personId,
        },
        logo: {
          '@type': 'ImageObject',
          url: `${SITE_URL}${ORGANIZATION_LOGO}`,
        },
        sameAs: [
          `${SITE_URL}/`,
          'https://chukwumaonyeije.com/',
          `${OPENMFM_URL}/`,
          'https://chukwumatheology.substack.com/',
          AUTHOR_X_URL,
          AUTHOR_BLUESKY_URL,
          AUTHOR_LINKEDIN_URL,
          AUTHOR_GITHUB_URL,
          AUTHOR_EMORY_URL,
          AUTHOR_PIEDMONT_URL,
          AUTHOR_DOXIMITY_URL,
          CODECRAFTMD_URL,
        ],
      },
      {
        '@type': 'Person',
        '@id': personId,
        name: AUTHOR_NAME,
        givenName: 'Chukwuma',
        familyName: 'Onyeije',
        alternateName: [
          'Dr. Chukwuma Onyeije',
          'Chukwuma Onyeije MD',
          'Chukwuma Ijeoma Onyeije',
          'Dr. O',
          '@chukwumaonyeije',
        ],
        honorificPrefix: 'Dr.',
        honorificSuffix: 'MD, FACOG',
        description: `${AUTHOR_NAME} is an Atlanta physician-developer, maternal-fetal medicine specialist, and founder of Doctors Who Code.`,
        url: AUTHOR_URL,
        jobTitle: ['Maternal-Fetal Medicine Specialist', 'Physician-Developer', 'Founder of Doctors Who Code'],
        homeLocation: {
          '@type': 'Place',
          name: AUTHOR_LOCATION,
        },
        worksFor: {
          '@type': 'MedicalOrganization',
          name: 'Atlanta Perinatal Associates',
        },
        mainEntityOfPage: AUTHOR_URL,
        founder: [
          { '@id': organizationId },
          {
            '@type': 'Organization',
            name: 'OpenMFM.org',
            url: OPENMFM_URL,
          },
        ],
        knowsAbout: [
          'Maternal-Fetal Medicine',
          'High-Risk Obstetrics',
          'Fetal Growth Restriction',
          'Gestational Diabetes',
          'Preeclampsia',
          'Clinical AI',
          'Medical Documentation',
          'Medical Billing',
          'FHIR',
          'Physician-Developer Education',
          'Open Medical Education',
        ],
        sameAs: [
          `${SITE_URL}/`,
          'https://chukwumaonyeije.com/',
          `${OPENMFM_URL}/`,
          'https://chukwumatheology.substack.com/',
          AUTHOR_X_URL,
          AUTHOR_BLUESKY_URL,
          AUTHOR_LINKEDIN_URL,
          AUTHOR_GITHUB_URL,
          AUTHOR_EMORY_URL,
          AUTHOR_PIEDMONT_URL,
          AUTHOR_DOXIMITY_URL,
          CODECRAFTMD_URL,
        ],
      },
      {
        '@type': 'WebPage',
        '@id': pageId,
        url: canonical,
        name: fullTitle,
        description,
        isPartOf: {
          '@id': websiteId,
        },
        about: {
          '@id': personId,
        },
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: ogImageAbsolute,
        },
      },
    ],
  },
  ...(Array.isArray(articleSchema) ? articleSchema : articleSchema ? [articleSchema] : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0d1a" media="(prefers-color-scheme: dark)" />
    <script is:inline set:html={themeScript} />

    <!-- Primary SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR_NAME} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noIndex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:alt" content={fullTitle} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={TWITTER_HANDLE} />
    <meta name="twitter:creator" content={TWITTER_HANDLE} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <!-- Dates for articles -->
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}

    <!-- Structured data -->
    {combinedSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="me" href={AUTHOR_LINKEDIN_URL} />
    <link rel="me" href={AUTHOR_X_URL} />
    <link rel="me" href={AUTHOR_BLUESKY_URL} />
    <link rel="me" href={AUTHOR_GITHUB_URL} />

    <!-- RSS -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={`${SITE_URL}/rss.xml`}
    />

    <!-- Vercel Analytics -->
    <script defer src="/_vercel/insights/script.js"></script>

  </head>

  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Header />

    <!-- Page content -->
    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <!-- Footer -->
    <SiteFooter />
  </body>
</html>
