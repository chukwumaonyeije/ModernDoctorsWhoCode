---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LearningPathCard from '../components/LearningPathCard.astro';
import CourseCard from '../components/CourseCard.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_URL } from '../consts';
import { sortBlogPosts } from '../utils/blog';
import { getCoursesForPath, getLearningPaths, getLessonsForCourse } from '../utils/learning';

const paths = await getLearningPaths();
const pathPrompts = {
  'learn-to-code': 'I have not shipped code yet.',
  'use-ai-in-medicine': 'I use AI, but I still coordinate every step.',
  'build-medical-software': 'I am ready to build a clinical tool.',
};
const pathCards = await Promise.all(paths.map(async (path) => {
  const courses = await getCoursesForPath(path.id);
  const lessons = (await Promise.all(courses.map((course) => getLessonsForCourse(course.id)))).flat();
  return {
    path,
    courseCount: courses.length,
    lessonCount: lessons.length,
    estimatedMinutes: courses.reduce((total, course) => total + course.data.estimatedMinutes, 0),
  };
}));

// One featured course per path (the first in its sequence), so the
// homepage gives courses direct visibility instead of only reaching
// them through a path page.
const featuredCourses = (await Promise.all(paths.map(async (path) => {
  const [firstCourse] = await getCoursesForPath(path.id);
  if (!firstCourse) return undefined;
  const lessonCount = (await getLessonsForCourse(firstCourse.id)).length;
  return { course: firstCourse, path, lessonCount };
}))).filter((entry) => entry !== undefined);

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = sortBlogPosts(allPosts).slice(0, 4);
const projects = [
  {
    label: 'Clinical Decision Support',
    title: 'FGRManager',
    description: 'SMFM fetal growth restriction guidance translated into a bedside delivery-timing tool.',
    href: 'https://openmfm.org/microsites/FGRManager/landing.html',
    mark: 'FGR',
  },
  {
    label: 'Open Medical Education',
    title: 'OpenMFM',
    description: 'Open-source maternal-fetal medicine education, clinical references, and physician-built tools.',
    href: 'https://openmfm.org',
    mark: 'MFM',
  },
  {
    label: 'Clinical Workflow Systems',
    title: 'CodeCraftMD',
    description: 'Physician-led documentation, coding, and workflow architecture built from clinical practice.',
    href: 'https://codecraftmd.com',
    mark: 'CC',
  },
];
const homeSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${SITE_URL}/#home`,
      url: SITE_URL,
      name: 'Doctors Who Code | Physician-Developer Learning Platform',
      description: SITE_DESCRIPTION,
      mainEntity: { '@id': `${SITE_URL}/chukwuma-onyeije#person` },
      isPartOf: { '@id': `${SITE_URL}/#website` },
    },
    {
      '@type': 'ItemList',
      '@id': `${SITE_URL}/#learning-paths`,
      name: 'Doctors Who Code Learning Paths',
      itemListElement: paths.map((path, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: `${SITE_URL}/paths/${path.id}/`,
        name: path.data.title,
      })),
    },
  ],
};
---

<BaseLayout
  title="Physician-Developer Learning Platform"
  description={SITE_DESCRIPTION}
  canonical={SITE_URL}
  articleSchema={homeSchema}
>
  <section class="home-hero site-shell">
    <div class="home-hero-copy">
      <p class="label">Physician-Developer Academy</p>
      <h1>Medicine needs more physicians who can build.</h1>
      <p class="lede-copy">
        Doctors Who Code is a guided learning platform for physicians who want to understand software, use AI with judgment, and build clinical tools that survive contact with real practice.
      </p>
      <div class="home-hero-actions">
        <a href="/start/" class="site-button site-button--primary">Find your starting point</a>
        <a href="/blog/" class="site-button site-button--secondary">Browse the article archive</a>
      </div>
      <dl class="home-provenance">
        <div>
          <dt>Written from</dt>
          <dd>Maternal-Fetal Medicine practice</dd>
        </div>
        <div>
          <dt>Built by</dt>
          <dd>Chukwuma Onyeije, MD, FACOG</dd>
        </div>
      </dl>
    </div>

    <aside class="home-orientation" aria-labelledby="orientation-title">
      <p class="label">Choose by Current Work</p>
      <h2 id="orientation-title">Where are you in the physician-developer journey?</h2>
      <ol>
        {pathCards.map(({ path, lessonCount }) => (
          <li>
            <a href={`/paths/${path.id}/`}>
              <span>{String(path.data.order).padStart(2, '0')}</span>
              <span>
                <strong>{path.data.title}</strong>
                <small>{pathPrompts[path.id as keyof typeof pathPrompts]}</small>
              </span>
              <span class="orientation-count">{lessonCount} lessons</span>
            </a>
          </li>
        ))}
      </ol>
      <a href="/start/" class="home-orientation-link">Compare the three paths <span aria-hidden="true">→</span></a>
    </aside>
  </section>

  <section class="home-section site-shell" aria-labelledby="paths-title">
    <div class="home-section-heading">
      <div>
        <p class="label">Learning Paths</p>
        <h2 id="paths-title">Begin with the gap you need to close.</h2>
      </div>
      <p>
        The archive contains the full body of work. These paths give selected articles an instructional order and a project at the end.
      </p>
    </div>
    <div class="home-path-grid">
      {pathCards.map(({ path, courseCount, lessonCount, estimatedMinutes }) => (
        <LearningPathCard
          path={path}
          courseCount={courseCount}
          lessonCount={lessonCount}
          estimatedMinutes={estimatedMinutes}
        />
      ))}
    </div>
  </section>

  <section class="home-section site-shell home-start" aria-labelledby="start-guide-title">
    <div class="home-start-copy">
      <p class="label">Featured Start Here Guide</p>
      <h2 id="start-guide-title">One path. One course. One finished build.</h2>
      <p>
        Do not begin by trying to understand the entire software landscape. Choose the path that matches your present work. Complete its first course in order. Build the project before adding another course.
      </p>
      <a href="/start/" class="site-button site-button--primary">Open Start Here</a>
    </div>
    <ol class="home-start-steps">
      <li>
        <span>01</span>
        <div><strong>Locate the gap</strong><small>Code, AI workflow design, or medical software.</small></div>
      </li>
      <li>
        <span>02</span>
        <div><strong>Follow the sequence</strong><small>Lessons are ordered by dependency, not publication date.</small></div>
      </li>
      <li>
        <span>03</span>
        <div><strong>Produce the artifact</strong><small>A utility, workflow map, or tested calculator.</small></div>
      </li>
    </ol>
  </section>

  {featuredCourses.length > 0 && (
    <section class="home-section site-shell" aria-labelledby="courses-title">
      <div class="home-section-heading">
        <div>
          <p class="label">Featured Courses</p>
          <h2 id="courses-title">Start the first course in each path.</h2>
        </div>
        <a href="/courses/" class="home-heading-link">Browse all courses <span aria-hidden="true">→</span></a>
      </div>
      <div class="home-course-grid">
        {featuredCourses.map(({ course, path, lessonCount }) => (
          <CourseCard course={course} path={path} lessonCount={lessonCount} />
        ))}
      </div>
    </section>
  )}

  <section class="home-section site-shell" aria-labelledby="projects-title">
    <div class="home-section-heading">
      <div>
        <p class="label">Physician-Built Projects</p>
        <h2 id="projects-title">The argument is visible in the systems.</h2>
      </div>
      <p>
        The platform teaches from working examples built inside clinical practice, not from abstract product exercises.
      </p>
    </div>
    <div class="home-project-grid">
      {projects.map((project) => (
        <a href={project.href} class="home-project-card" target="_blank" rel="noopener noreferrer">
          <span class="home-project-mark" aria-hidden="true">{project.mark}</span>
          <p class="label">{project.label}</p>
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          <span class="home-project-link">View project <span aria-hidden="true">↗</span></span>
        </a>
      ))}
    </div>
  </section>

  {latestPosts.length > 0 && (
    <section class="home-section site-shell" aria-labelledby="latest-title">
      <div class="home-section-heading">
        <div>
          <p class="label">Latest from the Journal</p>
          <h2 id="latest-title">The work continues between courses.</h2>
        </div>
        <a href="/blog/" class="home-heading-link">Browse all articles <span aria-hidden="true">→</span></a>
      </div>
      <div class="home-post-grid">
        {latestPosts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.id}
            tags={post.data.tags}
            category={post.data.category}
            readingTime={post.data.readingTime}
            image={post.data.image}
            featured={post.data.featured}
          />
        ))}
      </div>
    </section>
  )}

  <section class="home-section site-shell home-newsletter" id="newsletter" aria-label="Newsletter signup">
    <NewsletterForm />
  </section>
</BaseLayout>

<style>
  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(3rem, 2rem + 3vw, 5rem);
    padding-top: clamp(3.5rem, 2.5rem + 4vw, 6rem);
    padding-bottom: clamp(4rem, 3rem + 4vw, 6.5rem);
  }

  .home-hero-copy > .label,
  .home-orientation > .label,
  .home-section-heading .label,
  .home-start .label,
  .home-project-card .label {
    margin-bottom: 0.75rem;
  }

  .home-hero h1 {
    max-width: 15ch;
    margin-bottom: 1.25rem;
    font-size: clamp(2.35rem, 1.55rem + 3vw, 4rem);
    letter-spacing: -0.025em;
  }

  .home-hero .lede-copy {
    max-width: 41rem;
  }

  .home-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.75rem;
  }

  .home-hero-actions .site-button {
    width: auto;
  }

  .home-provenance {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    max-width: 42rem;
    margin: 2rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--dwc-border);
  }

  .home-provenance dt {
    margin-bottom: 0.25rem;
    color: var(--dwc-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .home-provenance dd {
    margin: 0;
    color: var(--dwc-white);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .home-orientation {
    width: min(100%, 48rem);
    overflow: hidden;
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 1rem;
    background:
      radial-gradient(circle at top right, rgba(56, 189, 248, 0.12), transparent 35%),
      var(--dwc-card);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.24);
  }

  .home-orientation > .label,
  .home-orientation > h2,
  .home-orientation > .home-orientation-link {
    margin-inline: 1.25rem;
  }

  .home-orientation > .label {
    margin-top: 1.25rem;
  }

  .home-orientation h2 {
    max-width: 25ch;
    margin-bottom: 1.25rem;
    font-size: clamp(1.35rem, 1.15rem + 0.8vw, 1.65rem);
  }

  .home-orientation ol {
    margin: 0;
    padding: 0;
    border-block: 1px solid var(--dwc-border);
    list-style: none;
  }

  .home-orientation li + li {
    border-top: 1px solid var(--dwc-border);
  }

  .home-orientation li a {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    gap: 0.85rem;
    align-items: center;
    min-height: 5.25rem;
    padding: 0.9rem 1.25rem;
    color: inherit;
  }

  .home-orientation li a:hover {
    background: rgba(56, 189, 248, 0.05);
    color: inherit;
  }

  .home-orientation li a > span:first-child,
  .orientation-count {
    color: var(--dwc-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .home-orientation li a > span:nth-child(2) {
    display: grid;
    gap: 0.2rem;
  }

  .home-orientation strong {
    color: var(--dwc-white);
    font-family: var(--font-display);
    font-size: 0.96rem;
  }

  .home-orientation small {
    color: var(--dwc-muted);
    font-size: 0.78rem;
    line-height: 1.4;
  }

  .orientation-count {
    white-space: nowrap;
  }

  .home-orientation-link,
  .home-heading-link,
  .home-project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .home-orientation-link {
    margin-block: 1.1rem;
  }

  .home-section {
    padding-bottom: clamp(4rem, 3rem + 3vw, 6rem);
  }

  .home-section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }

  .home-section-heading h2 {
    max-width: 19ch;
    margin: 0;
    font-size: clamp(1.7rem, 1.3rem + 1.5vw, 2.25rem);
  }

  .home-section-heading > p {
    max-width: 34rem;
    margin: 0;
    color: var(--dwc-muted);
  }

  .home-path-grid,
  .home-project-grid,
  .home-course-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .home-start {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(22rem, 0.8fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
    max-width: 1160px;
    margin-bottom: clamp(4rem, 3rem + 3vw, 6rem);
    padding: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 1rem;
    background:
      linear-gradient(110deg, rgba(168, 85, 247, 0.05), transparent 46%),
      var(--dwc-card);
  }

  .home-start-copy h2 {
    max-width: 15ch;
    font-size: clamp(1.8rem, 1.35rem + 1.6vw, 2.4rem);
  }

  .home-start-copy p:not(.label) {
    color: var(--dwc-muted);
  }

  .home-start-copy .site-button {
    width: auto;
  }

  .home-start-steps {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-start-steps li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--dwc-border);
  }

  .home-start-steps li:first-child { padding-top: 0; }
  .home-start-steps li:last-child { padding-bottom: 0; border-bottom: 0; }

  .home-start-steps li > span {
    color: var(--dwc-cyan);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .home-start-steps div {
    display: grid;
    gap: 0.2rem;
  }

  .home-start-steps strong {
    color: var(--dwc-white);
    font-family: var(--font-display);
    font-size: 0.95rem;
  }

  .home-start-steps small {
    color: var(--dwc-muted);
    line-height: 1.5;
  }

  .home-project-card {
    display: block;
    min-height: 18rem;
    padding: 1.5rem;
    border: 1px solid var(--dwc-border);
    border-radius: 1rem;
    color: inherit;
    background: var(--dwc-card);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .home-project-card:hover {
    border-color: rgba(56, 189, 248, 0.5);
    color: inherit;
    transform: translateY(-2px);
  }

  .home-project-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: 1.25rem;
    border: 1px solid rgba(56, 189, 248, 0.3);
    border-radius: 0.75rem;
    color: var(--dwc-cyan);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .home-project-card h3 {
    margin-bottom: 0.6rem;
  }

  .home-project-card > p:not(.label) {
    color: var(--dwc-muted);
    font-size: 0.94rem;
    line-height: 1.6;
  }

  .home-post-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .home-newsletter {
    padding-bottom: 0;
  }

  @media (max-width: 980px) {
    .home-start {
      grid-template-columns: 1fr;
    }

    .home-path-grid,
    .home-project-grid,
    .home-course-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .home-section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }

    .home-post-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .home-hero {
      padding-top: 2.75rem;
    }

    .home-hero h1 {
      max-width: none;
      font-size: clamp(2.15rem, 9vw, 2.5rem);
    }

    .home-hero-actions {
      flex-direction: column;
    }

    .home-hero-actions .site-button,
    .home-start-copy .site-button {
      width: 100%;
    }

    .home-provenance {
      grid-template-columns: 1fr;
    }

    .home-orientation li a {
      grid-template-columns: 1.8rem minmax(0, 1fr);
    }

    .orientation-count {
      grid-column: 2;
    }
  }
</style>
