---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { SITE_DESCRIPTION, SITE_URL } from '../consts';
import { sortBlogPosts } from '../utils/blog';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = sortBlogPosts(allPosts);
const featuredPosts = sortedPosts.filter((post) => post.data.featured);
const featuredPost = featuredPosts[0] ?? sortedPosts[0];
const recentPosts = sortedPosts.filter((post) => post.id !== featuredPost?.id).slice(0, 5);

const hexTerms = [
  'Physician-Developer',
  'AI in Medicine',
  'Maternal-Fetal Medicine',
  'Clinical Workflow',
  'FHIR',
  'Python',
  'TypeScript',
  'Clinical Documentation',
  'Interoperability',
  'Medical Billing',
  'OpenMFM',
  'Bedside Tools',
];
const uniqueTags = new Set(sortedPosts.flatMap((post) => post.data.tags.map((tag) => tag.toLowerCase())));
const stats = [
  { number: String(sortedPosts.length), label: 'Published Essays' },
  { number: String(uniqueTags.size), label: 'Recurring Topics' },
  { number: 'MFM', label: 'Clinical Specialty' },
  { number: 'ATL', label: 'Clinical Base' },
];
const startHere = [
  {
    label: 'Official Profile',
    title: 'Start with Dr. Chukwuma Onyeije',
    copy: 'See the clinical background, public identity, current projects, and the case for physician-built software.',
    href: '/chukwuma-onyeije',
    cta: 'Read the profile',
  },
  {
    label: 'Core Argument',
    title: 'Why physicians should build',
    copy: 'Read the thesis behind Doctors Who Code: doctors should not only use medical technology. They should help author it.',
    href: '/blog/ama-augmented-intelligence-physician-developer',
    cta: 'Read the essay',
  },
  {
    label: 'Builder Work',
    title: 'See a real physician-built tool',
    copy: 'Follow the path from clinical protocol to bedside software in a concrete build teardown.',
    href: '/blog/how-i-built-fgrmanager-a-physician-developers-blueprint-for-turning-clinical-protocols-into-bedside-tools',
    cta: 'See the build',
  },
];
const topicLinks = [
  { label: 'Physician-Developer', href: '/blog?q=physician-developer' },
  { label: 'AI in Medicine', href: '/blog?q=AI' },
  { label: 'FHIR and Interoperability', href: '/blog?q=FHIR' },
  { label: 'Maternal-Fetal Medicine', href: '/blog?q=maternal-fetal%20medicine' },
];
const homeSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${SITE_URL}/#home`,
      url: SITE_URL,
      name: 'Doctors Who Code | Official Site of Chukwuma Onyeije, MD, FACOG',
      description: SITE_DESCRIPTION,
      mainEntity: {
        '@id': `${SITE_URL}/about#person`,
      },
      isPartOf: {
        '@id': `${SITE_URL}/#website`,
      },
    },
    {
      '@type': 'ItemList',
      '@id': `${SITE_URL}/#start-here`,
      name: 'Start Here on Doctors Who Code',
      itemListElement: startHere.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: `${SITE_URL}${item.href}`,
        name: item.title,
      })),
    },
  ],
};
---

<BaseLayout
  title="Official Site of Chukwuma Onyeije, MD, FACOG"
  description={SITE_DESCRIPTION}
  canonical={SITE_URL}
  articleSchema={homeSchema}
>

  <!-- Hero -->
  <section class="home-hero page-shell">
    <div>
      <p class="label" style="margin-bottom: 1rem;">
        <span class="live-dot" style="margin-right: 0.5rem;"></span>
        Official Site · Physician-Developer Journal
      </p>
      <h1 class="gradient-text home-hero-title">Doctors Who Code</h1>
      <p class="home-hero-kicker">
        The official site of Chukwuma Onyeije, MD, FACOG.
      </p>
      <p class="lede-copy home-hero-copy">
        Doctors Who Code is where I write as an Atlanta maternal-fetal medicine specialist and
        physician-developer building AI tools, clinical documentation systems, and physician-led
        software.
      </p>
      <p class="home-hero-copy home-hero-copy--secondary">
        If you searched for Chukwuma Onyeije MD, Doctors Who Code, or physician-builder essays on
        AI in medicine, you are in the right place.
      </p>
      <form id="hero-search" class="home-search">
        <input type="text" id="hero-q" placeholder="Search articles..."
          class="site-input home-search-input" />
        <button type="submit"
          class="home-search-button">Search</button>
      </form>
      <div class="mobile-stack">
        <a
          href="/blog"
          class="site-button site-button--primary home-action"
        >Read the Blog</a>
        <a
          href="/chukwuma-onyeije"
          class="site-button site-button--secondary home-action"
        >Official Profile</a>
        <a
          href="/contact"
          class="site-button site-button--secondary home-action"
        >Subscribe</a>
      </div>
      <div class="home-trust-grid">
        <div class="home-trust-card">
          <p class="label home-trust-label">Clinical Work</p>
          <p class="home-trust-copy">Maternal-Fetal Medicine at Atlanta Perinatal Associates</p>
        </div>
        <div class="home-trust-card">
          <p class="label home-trust-label">Builder Focus</p>
          <p class="home-trust-copy">AI, documentation, interoperability, and bedside tools</p>
        </div>
      </div>
    </div>

    <div style="display: grid; gap: 1rem; align-content: start;">
      {featuredPost && (
        <a
          href={`/blog/${featuredPost.id}`}
          class="home-path-card"
          style="padding: 0; overflow: hidden; gap: 0; text-decoration: none;"
        >
          {featuredPost.data.image && (
            <img
              src={featuredPost.data.image.url}
              alt={featuredPost.data.image.alt}
              style="width: 100%; height: 240px; object-fit: cover; display: block;"
            />
          )}
          <div style="padding: 1.25rem;">
            <p class="label" style="margin-bottom: 0.6rem;">Featured Now</p>
            <h2 class="home-path-title" style="margin-bottom: 0.75rem;">{featuredPost.data.title}</h2>
            <p class="home-path-copy" style="margin-bottom: 0.9rem;">{featuredPost.data.description}</p>
            <span class="home-feature-cta">Read featured article &rarr;</span>
          </div>
        </a>
      )}

      <div class="home-hex-grid" style="justify-content: flex-start;">
        {hexTerms.map((term, i) => (
          <div class="home-hex-chip" style={`color: ${i % 3 === 0 ? 'var(--dwc-cyan)' : 'var(--dwc-muted)'}; opacity: ${0.5 + (i % 3) * 0.25};`}>{term}</div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats strip -->
  <section class="site-shell home-stats-section">
    <div class="home-stats-grid">
      {stats.map(stat => (
        <div class="home-stat-card">
          <p class="gradient-text home-stat-number">{stat.number}</p>
          <p class="home-stat-label">{stat.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="site-shell home-section">
    <div class="home-section-header">
      <div>
        <p class="label">Start Here</p>
        <h2 class="gradient-text home-subsection-title">Three ways into the site</h2>
      </div>
      <p class="home-section-intro">
        Start with the official profile, the core argument, or a real physician-built project.
      </p>
    </div>
    <div class="home-path-grid">
      {startHere.map((item) => (
        <a href={item.href} class="home-path-card">
          <p class="label" style="margin-bottom: 0.75rem;">{item.label}</p>
          <h3 class="home-path-title">{item.title}</h3>
          <p class="home-path-copy">{item.copy}</p>
          <span class="home-section-link">{item.cta} &rarr;</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Recent Posts -->
  {recentPosts.length > 0 && (
    <section class="site-shell home-section">
      <div class="home-section-header">
        <p class="label">Recent Posts</p>
        <a href="/blog" class="home-section-link">All posts &rarr;</a>
      </div>
      <div class="home-post-grid">
        {recentPosts.map(post => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.id}
            tags={post.data.tags}
            category={post.data.category}
            readingTime={post.data.readingTime}
            image={post.data.image}
            featured={post.data.featured}
          />
        ))}
        <div class="home-more-card">
          <a href="/blog" class="site-button site-button--primary home-more-link">Read the Blog &rarr;</a>
        </div>
      </div>
    </section>
  )}

  <section class="site-shell home-section">
    <div class="home-section-header">
      <div>
        <p class="label">Explore</p>
        <h2 class="gradient-text home-subsection-title">Follow the topics that define the work</h2>
      </div>
      <a href="/blog" class="home-section-link">Browse all writing &rarr;</a>
    </div>
    <div class="home-topic-row">
      {topicLinks.map((topic) => (
        <a href={topic.href} class="tag-pill home-topic-pill">{topic.label}</a>
      ))}
    </div>
  </section>

  <!-- About Strip -->
  <section style="background-color: var(--dwc-card); border-top: 1px solid var(--dwc-border); border-bottom: 1px solid var(--dwc-border); margin-bottom: 4rem;">
    <div class="site-shell home-about-grid">
      <div>
        <p class="label" style="margin-bottom: 1rem;">About the Author</p>
        <h2 class="gradient-text home-about-title">Chukwuma Onyeije, MD, FACOG</h2>
        <p class="home-about-copy" style="margin-bottom: 1rem;">
          I am a maternal-fetal medicine specialist at Atlanta Perinatal Associates and a
          physician-developer building AI-powered clinical tools because physicians with domain
          expertise build better healthcare technology than distant vendors ever will.
        </p>
        <p class="home-about-copy">
          I founded CodeCraftMD for physician-led AI documentation and billing systems, and
          OpenMFM.org for open-source maternal-fetal medicine education.
        </p>
        <a href="/chukwuma-onyeije" class="home-section-link" style="display: inline-block; margin-top: 1.25rem;">About Chukwuma Onyeije, MD, FACOG &rarr;</a>
      </div>
      <div class="home-about-cards">
        {[
          { label: 'Official Site', value: 'DoctorsWhoCode.blog' },
          { label: 'Specialty', value: 'MFM / High-Risk OB' },
          { label: 'Credential', value: 'MD, FACOG' },
          { label: 'Project', value: 'CodeCraftMD' },
          { label: 'Project', value: 'OpenMFM.org' },
        ].map(item => (
          <div class="home-about-card">
            <p class="label" style="margin-bottom: 0.25rem; font-size: 0.65rem;">{item.label}</p>
            <p class="home-about-card-copy">{item.value}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section id="newsletter" class="site-shell home-section home-newsletter-section">
    <NewsletterForm />
  </section>

</BaseLayout>

<script>
  document.getElementById('hero-search')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const q = (document.getElementById('hero-q') as HTMLInputElement)?.value.trim();
    if (q) window.location.href = '/blog?q=' + encodeURIComponent(q);
  });
</script>

<style>
  .home-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 1.25rem + 3vw, 4rem);
    align-items: center;
    padding-top: clamp(3.5rem, 2.6rem + 3vw, 5rem);
    padding-bottom: 4rem;
  }

  .home-hero-title {
    font-size: clamp(2.4rem, 1.55rem + 3vw, 3.25rem);
    line-height: 1.05;
    margin-bottom: 0.65rem;
  }

  .home-hero-kicker {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(1.08rem, 0.98rem + 0.45vw, 1.3rem);
    line-height: 1.35;
    color: var(--dwc-white);
  }

  .home-hero-copy {
    margin-bottom: 1rem;
    max-width: 32rem;
  }

  .home-hero-copy--secondary {
    margin-bottom: 1.5rem;
    color: var(--dwc-muted);
  }

  .home-search {
    display: flex;
    margin-bottom: 1.75rem;
  }

  .home-search-input {
    flex: 1;
    border-right: none;
    border-radius: 8px 0 0 8px;
  }

  .home-search-button {
    border: none;
    border-radius: 0 8px 8px 0;
    padding: 0.7rem 1.25rem;
    background: var(--dwc-blue);
    color: var(--dwc-white);
    font-family: var(--font-mono);
    font-size: var(--font-size-button);
    cursor: pointer;
  }

  .home-action {
    width: auto;
  }

  .home-trust-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
    max-width: 42rem;
  }

  .home-trust-card,
  .home-path-card {
    background-color: var(--dwc-card);
    border: 1px solid var(--dwc-border);
    border-radius: 12px;
  }

  .home-trust-card {
    padding: 1rem;
  }

  .home-trust-label {
    margin-bottom: 0.35rem;
  }

  .home-trust-copy {
    margin: 0;
    color: var(--dwc-muted);
    line-height: 1.55;
  }

  .home-hex-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    align-items: center;
  }

  .home-hex-chip {
    font-family: var(--font-mono);
    font-size: clamp(0.82rem, 0.79rem + 0.15vw, 0.88rem);
    font-weight: 500;
    background-color: var(--dwc-card);
    border: 1px solid var(--dwc-border);
    padding: 0.55rem 1rem;
    border-radius: 8px;
  }

  .home-stats-section,
  .home-section {
    padding-bottom: 3rem;
  }

  .home-subsection-title {
    margin: 0.4rem 0 0;
    font-size: clamp(1.45rem, 1.22rem + 0.9vw, 1.8rem);
  }

  .home-section-intro {
    margin: 0;
    max-width: 34rem;
    color: var(--dwc-muted);
    line-height: 1.6;
  }

  .home-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .home-stat-card {
    background: var(--dwc-card);
    border: 1px solid var(--dwc-border);
    border-radius: 12px;
    padding: clamp(1rem, 0.8rem + 0.8vw, 1.5rem);
    text-align: center;
  }

  .home-stat-number {
    margin: 0 0 0.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2rem);
    font-weight: 800;
    line-height: 1;
  }

  .home-stat-label,
  .home-section-link,
  .home-feature-cta {
    font-family: var(--font-mono);
    font-size: clamp(0.8rem, 0.77rem + 0.16vw, 0.85rem);
    color: var(--dwc-cyan);
  }

  .home-feature-title {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 1.75rem);
    margin-bottom: 0.5rem;
  }

  .home-feature-copy {
    margin: 0;
    font-size: clamp(0.98rem, 0.95rem + 0.16vw, 1rem);
    line-height: 1.6;
    color: var(--dwc-muted);
    max-width: 52ch;
  }

  .home-section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .home-post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .home-path-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .home-path-card {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding: 1.35rem;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .home-path-card:hover {
    transform: translateY(-2px);
    border-color: var(--dwc-blue);
  }

  .home-path-title {
    margin: 0;
    font-size: clamp(1.08rem, 1rem + 0.36vw, 1.2rem);
    color: var(--dwc-white);
  }

  .home-path-copy {
    margin: 0;
    color: var(--dwc-muted);
    line-height: 1.65;
  }

  .home-more-card {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--dwc-card);
    border: 1px solid var(--dwc-border);
    border-radius: 12px;
    padding: 2rem;
    min-height: 180px;
  }

  .home-more-link {
    width: auto;
    padding-inline: 1.5rem;
  }

  .home-about-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: clamp(2rem, 1.25rem + 3vw, 4rem);
    align-items: center;
    padding-top: 4rem;
    padding-bottom: 4rem;
  }

  .home-about-title {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 1.75rem);
    margin-bottom: 1rem;
  }

  .home-about-copy {
    color: var(--dwc-muted);
    line-height: 1.72;
  }

  .home-about-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .home-about-card {
    background-color: var(--dwc-navy);
    border: 1px solid var(--dwc-border);
    border-radius: 8px;
    padding: 0.9rem;
  }

  .home-about-card-copy {
    margin: 0;
    font-size: clamp(0.92rem, 0.89rem + 0.14vw, 0.96rem);
    font-weight: 600;
    color: var(--dwc-white);
  }

  .home-topic-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .home-topic-pill {
    text-decoration: none;
  }

  .home-newsletter-section {
    padding-top: 0;
  }

  @media (max-width: 900px) {
    .home-hero,
    .home-about-grid {
      grid-template-columns: 1fr;
    }

    .home-path-grid,
    .home-stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .home-search {
      flex-direction: column;
      gap: 0.75rem;
    }

    .home-search-input {
      border-right: 1px solid var(--dwc-border);
      border-radius: 8px;
    }

    .home-search-button,
    .home-action,
    .home-more-link {
      width: 100%;
      border-radius: 8px;
    }

    .home-trust-grid,
    .home-about-cards,
    .home-path-grid,
    .home-stats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
