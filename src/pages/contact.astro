---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
---

<BaseLayout
  title="Contact"
  description="Subscribe to the Doctors Who Code newsletter or connect with Dr. Chukwuma Onyeije on LinkedIn."
>
  <div class="page-shell page-shell--compact">

    <div style="margin-bottom: 3rem;">
      <p class="label" style="margin-bottom: 0.75rem;">Get in Touch</p>
      <h1 class="contact-page-title">Contact</h1>
      <p class="contact-page-copy">
        The best way to reach me is LinkedIn. For general inquiries, speaking requests, or
        collaboration on physician-developer projects, connect there directly.
      </p>
    </div>

    <!-- Newsletter -->
    <div style="margin-bottom: 3rem;">
      <NewsletterForm />
    </div>

    <!-- LinkedIn CTA -->
    <div class="contact-linkedin-card">
      <div>
        <p class="label" style="margin-bottom: 0.375rem;">Connect on LinkedIn</p>
        <p class="contact-linkedin-copy">
          Chukwuma Onyeije, MD, FACOG
        </p>
      </div>
      <a
        href="https://linkedin.com/in/chukwumaonyeije"
        target="_blank"
        rel="noopener noreferrer"
        class="site-button site-button--primary contact-linkedin-button"
      >
        LinkedIn &rarr;
      </a>
    </div>

  </div>
</BaseLayout>

<style>
  .contact-page-title {
    font-size: clamp(2rem, 1.55rem + 1.6vw, 2.25rem);
    margin-bottom: 0.75rem;
  }

  .contact-page-copy {
    font-size: var(--font-size-body);
    color: var(--dwc-muted);
    line-height: 1.72;
  }

  .contact-linkedin-card {
    background-color: var(--dwc-card);
    border: 1px solid var(--dwc-border);
    border-radius: 12px;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .contact-linkedin-copy {
    margin: 0;
    font-size: clamp(0.98rem, 0.95rem + 0.16vw, 1rem);
    color: var(--dwc-muted);
  }

  .contact-linkedin-button {
    width: auto;
    white-space: nowrap;
  }

  @media (max-width: 520px) {
    .contact-linkedin-button {
      width: 100%;
    }
  }
</style>
