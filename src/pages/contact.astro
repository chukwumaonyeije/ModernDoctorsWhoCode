---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
---

<BaseLayout
  title="Contact"
  description="Subscribe to the Doctors Who Code newsletter or connect with Dr. Chukwuma Onyeije on LinkedIn."
>
  <div class="page-shell page-shell--compact">

    <div style="margin-bottom: 3rem;">
      <p class="label" style="margin-bottom: 0.75rem;">Get in Touch</p>
      <h1 class="contact-page-title">Contact</h1>
      <p class="contact-page-copy">
        The best way to reach me is LinkedIn. For general inquiries, speaking requests, or
        collaboration on physician-developer projects, connect there directly.
      </p>
    </div>

    <!-- Newsletter -->
    <section class="contact-newsletter-section" aria-labelledby="contact-newsletter-heading">
      <div class="contact-newsletter-intro">
        <p class="label" style="margin-bottom: 0.75rem;">Physician-Builder Newsletter</p>
        <h2 id="contact-newsletter-heading" class="contact-newsletter-title">
          Pick the track that matches the physician you are becoming.
        </h2>
        <p class="contact-newsletter-copy">
          Some physicians want to write their first useful script. Others want to deploy medical AI
          without losing clinical judgment. Others are ready to build tools that belong closer to
          the bedside than the vendor demo. Start in the right place.
        </p>
      </div>

      <NewsletterForm
        eyebrow="Lead Magnet"
        title="Get the Doctors Who Code starter resources."
        subtitle="Subscribe with your email, add your first name if you want, and choose the track that fits your current work. Beehiiv should route you into a matching onboarding sequence."
        note="Expect practical writing, resource bundles, and a measured cadence. No spam. No hype. Just physician-builder signal."
        formHeading="Primary interest options"
        postSignupTitle="Post-signup message to configure in Beehiiv"
        postSignupCopy="You are subscribed. Check your inbox for the first email in your selected track, including your starter resources and next practical step."
      />
    </section>

    <!-- LinkedIn CTA -->
    <div class="contact-linkedin-card">
      <div>
        <p class="label" style="margin-bottom: 0.375rem;">Connect on LinkedIn</p>
        <p class="contact-linkedin-copy">
          <a href="/about" class="contact-about-link">Chukwuma Onyeije, MD, FACOG</a>
        </p>
      </div>
      <a
        href="https://linkedin.com/in/chukwumaonyeije"
        target="_blank"
        rel="noopener noreferrer"
        class="site-button site-button--primary contact-linkedin-button"
      >
        LinkedIn &rarr;
      </a>
    </div>

  </div>
</BaseLayout>

<style>
  .contact-page-title {
    font-size: clamp(2rem, 1.55rem + 1.6vw, 2.25rem);
    margin-bottom: 0.75rem;
  }

  .contact-page-copy {
    font-size: var(--font-size-body);
    color: var(--dwc-muted);
    line-height: 1.72;
  }

  .contact-newsletter-section {
    margin-bottom: 3rem;
  }

  .contact-newsletter-intro {
    margin-bottom: 1.25rem;
  }

  .contact-newsletter-title {
    font-size: clamp(1.55rem, 1.25rem + 1vw, 1.9rem);
    margin-bottom: 0.75rem;
  }

  .contact-newsletter-copy {
    color: var(--dwc-muted);
    line-height: 1.72;
    max-width: 58ch;
  }

  .contact-linkedin-card {
    background-color: var(--dwc-card);
    border: 1px solid var(--dwc-border);
    border-radius: 12px;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .contact-linkedin-copy {
    margin: 0;
    font-size: clamp(0.98rem, 0.95rem + 0.16vw, 1rem);
    color: var(--dwc-muted);
  }

  .contact-about-link {
    color: inherit;
    text-decoration: none;
  }

  .contact-linkedin-button {
    width: auto;
    white-space: nowrap;
  }

  @media (max-width: 520px) {
    .contact-linkedin-button {
      width: 100%;
    }
  }
</style>
