---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { getReadingMetadata } from '../../utils/blog';
import PostLayout from '../../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content, headings } = await render(post);

// Use generated branded OG image for social sharing
const ogImage = `/og/${post.id}.png`;

const { wordCount, readingTime } = getReadingMetadata(post);
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  author={post.data.author}
  authorUrl={post.data.authorUrl}
  tags={post.data.tags}
  category={post.data.category}
  image={post.data.image}
  ogImage={ogImage}
  readingTime={readingTime}
  wordCount={wordCount}
  canonical={post.data.canonical}
  audioUrl={post.data.audioUrl}
  headings={headings}
>
  <Content />
</PostLayout>
