---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { buildTagIndex, slugifyTag } from '../../utils/tags';
import { SITE_URL } from '../../consts';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const initialQuery = Astro.url.searchParams.get('q')?.trim() ?? '';

const tagIndex = buildTagIndex(sortedPosts.flatMap((post) => post.data.tags));
const allTags = [...tagIndex.entries()]
  .filter(([, value]) => value.count >= 3)
  .sort((a, b) => b[1].count - a[1].count)
  .map(([slug, value]) => ({ slug, label: value.label }));
const blogSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Blog',
      '@id': `${SITE_URL}/blog#blog`,
      url: `${SITE_URL}/blog`,
      name: 'Doctors Who Code Blog',
      description: 'Physician-developer writing on AI in medicine, clinical software, interoperability, and maternal-fetal medicine.',
      publisher: {
        '@id': `${SITE_URL}/#organization`,
      },
      author: {
        '@id': `${SITE_URL}/about#person`,
      },
    },
    {
      '@type': 'CollectionPage',
      '@id': `${SITE_URL}/blog#webpage`,
      url: `${SITE_URL}/blog`,
      name: 'Doctors Who Code Blog',
      description: 'Browse all Doctors Who Code posts by Chukwuma Onyeije, MD, FACOG.',
      mainEntity: {
        '@id': `${SITE_URL}/blog#blog`,
      },
      isPartOf: {
        '@id': `${SITE_URL}/#website`,
      },
    },
  ],
};
---

<BaseLayout
  title="Physician-Developer Blog"
  description="Physician-developer insights on AI in medicine, clinical software, MFM practice, and building tools that actually work at the bedside."
  canonical="https://www.doctorswhocode.blog/blog"
  articleSchema={blogSchema}
>
  <div class="page-shell">

    <!-- Header -->
    <div class="blog-index-header">
      <div>
        <p class="label" style="margin-bottom: 0.5rem;">All Posts</p>
        <h1 class="gradient-text blog-index-title">The Blog</h1>
        <p class="blog-index-intro">
          Essays, build notes, and physician-developer arguments from Chukwuma Onyeije, MD, FACOG.
          Search by idea, or filter by recurring topics.
        </p>
      </div>
      <input
        type="search"
        id="post-search"
        placeholder="Search posts..."
        class="site-input blog-index-search"
        value={initialQuery}
      />
    </div>

    <!-- Tag filter — single scrollable row -->
    <div class="blog-index-tags mobile-scroll">
      <div class="blog-index-tags-row" id="tag-filters">
        <button class="tag-btn blog-tag-button blog-tag-button--active" data-tag="all">All</button>
        {allTags.map(tag => (
          <button class="tag-btn blog-tag-button" data-tag={tag.slug}>{tag.label}</button>
        ))}
      </div>
    </div>

    <!-- Posts grid -->
    <div id="posts-grid" class="blog-index-grid">
      {sortedPosts.map(post => (
        <div class="post-item" data-tags={post.data.tags.map(tag => slugifyTag(tag)).join(',')} data-title={post.data.title.toLowerCase()} data-description={post.data.description.toLowerCase()}>
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.id}
            tags={post.data.tags}
            category={post.data.category}
            readingTime={post.data.readingTime}
            image={post.data.image}
            featured={post.data.featured}
          />
        </div>
      ))}
    </div>

    <!-- Empty state -->
    <div id="no-results" class="blog-index-empty">
      <p class="eyebrow-copy">No posts match that filter.</p>
    </div>

  </div>
</BaseLayout>

<script>
  const tagBtns = document.querySelectorAll<HTMLButtonElement>('.tag-btn');
  const postItems = document.querySelectorAll<HTMLElement>('.post-item');
  const searchInput = document.getElementById('post-search') as HTMLInputElement;
  const noResults = document.getElementById('no-results')!;

  let activeTag = 'all';
  let searchQuery = searchInput?.value.toLowerCase().trim() ?? '';

  function paintActiveTag() {
    tagBtns.forEach((btn) => {
      const isActive = (btn.dataset.tag ?? 'all') === activeTag;
      btn.style.borderColor = isActive ? 'var(--dwc-cyan)' : 'var(--dwc-border)';
      btn.style.color = isActive ? 'var(--dwc-navy)' : 'var(--dwc-muted)';
      btn.style.backgroundColor = isActive ? 'var(--dwc-cyan)' : 'transparent';
    });
  }

  function syncQueryParam() {
    const url = new URL(window.location.href);
    if (searchQuery) {
      url.searchParams.set('q', searchQuery);
    } else {
      url.searchParams.delete('q');
    }
    window.history.replaceState({}, '', `${url.pathname}${url.search}`);
  }

  function filterPosts() {
    let visible = 0;
    postItems.forEach(item => {
      const tags = item.dataset.tags ?? '';
      const title = item.dataset.title ?? '';
      const desc = item.dataset.description ?? '';
      const matchesTag = activeTag === 'all' || tags.split(',').includes(activeTag);
      const matchesSearch = !searchQuery || title.includes(searchQuery) || desc.includes(searchQuery);
      if (matchesTag && matchesSearch) {
        item.style.display = '';
        visible++;
      } else {
        item.style.display = 'none';
      }
    });
    noResults.style.display = visible === 0 ? 'block' : 'none';
  }

  tagBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      activeTag = btn.dataset.tag ?? 'all';
      paintActiveTag();
      filterPosts();
    });
  });

  searchInput.addEventListener('input', () => {
    searchQuery = searchInput.value.toLowerCase().trim();
    syncQueryParam();
    filterPosts();
  });

  paintActiveTag();
  filterPosts();
</script>

<style>
  .blog-index-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .blog-index-title {
    margin: 0;
    font-size: clamp(2rem, 1.45rem + 2vw, 2.5rem);
  }

  .blog-index-intro {
    margin: 0.75rem 0 0;
    max-width: 46rem;
    color: var(--dwc-muted);
    line-height: 1.7;
  }

  .blog-index-search {
    width: min(100%, 320px);
  }

  .blog-index-tags {
    overflow-x: auto;
    padding-bottom: 0.5rem;
    margin-bottom: 2rem;
  }

  .blog-index-tags-row {
    display: flex;
    gap: 0.5rem;
    min-width: max-content;
  }

  .blog-tag-button {
    font-family: var(--font-mono);
    font-size: clamp(0.72rem, 0.69rem + 0.12vw, 0.76rem);
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--dwc-border);
    color: var(--dwc-muted);
    background-color: transparent;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .blog-tag-button--active {
    border-color: var(--dwc-cyan);
    color: var(--dwc-navy);
    background-color: var(--dwc-cyan);
  }

  .blog-index-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .blog-index-empty {
    display: none;
    text-align: center;
    padding: 4rem 0;
  }

  @media (max-width: 520px) {
    .blog-index-grid {
      grid-template-columns: 1fr;
    }

    .blog-index-search {
      width: 100%;
    }
  }
</style>
