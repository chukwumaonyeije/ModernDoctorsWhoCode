---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { buildTagIndex, slugifyTag } from '../../utils/tags';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const tagIndex = buildTagIndex(sortedPosts.flatMap((post) => post.data.tags));
const allTags = [...tagIndex.entries()]
  .filter(([, value]) => value.count >= 3)
  .sort((a, b) => b[1].count - a[1].count)
  .map(([slug, value]) => ({ slug, label: value.label }));
---

<BaseLayout
  title="Blog"
  description="Physician-developer insights on AI in medicine, clinical software, MFM practice, and building tools that actually work."
>
  <div class="page-shell">

    <!-- Header -->
    <div class="blog-index-header">
      <div>
        <p class="label" style="margin-bottom: 0.5rem;">All Posts</p>
        <h1 class="gradient-text blog-index-title">The Blog</h1>
      </div>
      <input
        type="search"
        id="post-search"
        placeholder="Search posts..."
        class="site-input blog-index-search"
      />
    </div>

    <!-- Tag filter — single scrollable row -->
    <div class="blog-index-tags mobile-scroll">
      <div class="blog-index-tags-row" id="tag-filters">
        <button class="tag-btn active" data-tag="all"
          class="blog-tag-button blog-tag-button--active"
        >All</button>
        {allTags.map(tag => (
          <button class="tag-btn" data-tag={tag.slug}
            class="blog-tag-button"
          >{tag.label}</button>
        ))}
      </div>
    </div>

    <!-- Posts grid -->
    <div id="posts-grid" class="blog-index-grid">
      {sortedPosts.map(post => (
        <div class="post-item" data-tags={post.data.tags.map(tag => slugifyTag(tag)).join(',')} data-title={post.data.title.toLowerCase()} data-description={post.data.description.toLowerCase()}>
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.id}
            tags={post.data.tags}
            category={post.data.category}
            readingTime={post.data.readingTime}
            image={post.data.image}
            featured={post.data.featured}
          />
        </div>
      ))}
    </div>

    <!-- Empty state -->
    <div id="no-results" class="blog-index-empty">
      <p class="eyebrow-copy">No posts match that filter.</p>
    </div>

  </div>
</BaseLayout>

<script>
  const tagBtns = document.querySelectorAll<HTMLButtonElement>('.tag-btn');
  const postItems = document.querySelectorAll<HTMLElement>('.post-item');
  const searchInput = document.getElementById('post-search') as HTMLInputElement;
  const noResults = document.getElementById('no-results')!;

  let activeTag = 'all';
  let searchQuery = '';

  function filterPosts() {
    let visible = 0;
    postItems.forEach(item => {
      const tags = item.dataset.tags ?? '';
      const title = item.dataset.title ?? '';
      const desc = item.dataset.description ?? '';
      const matchesTag = activeTag === 'all' || tags.split(',').includes(activeTag);
      const matchesSearch = !searchQuery || title.includes(searchQuery) || desc.includes(searchQuery);
      if (matchesTag && matchesSearch) {
        item.style.display = '';
        visible++;
      } else {
        item.style.display = 'none';
      }
    });
    noResults.style.display = visible === 0 ? 'block' : 'none';
  }

  tagBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      activeTag = btn.dataset.tag ?? 'all';
      tagBtns.forEach(b => {
        b.style.borderColor = 'var(--dwc-border)';
        b.style.color = 'var(--dwc-muted)';
        b.style.backgroundColor = 'transparent';
      });
      btn.style.borderColor = 'var(--dwc-cyan)';
      btn.style.color = 'var(--dwc-navy)';
      btn.style.backgroundColor = 'var(--dwc-cyan)';
      filterPosts();
    });
  });

  searchInput.addEventListener('input', () => {
    searchQuery = searchInput.value.toLowerCase().trim();
    filterPosts();
  });
</script>

<style>
  .blog-index-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .blog-index-title {
    margin: 0;
    font-size: clamp(2rem, 1.45rem + 2vw, 2.5rem);
  }

  .blog-index-search {
    width: min(100%, 320px);
  }

  .blog-index-tags {
    overflow-x: auto;
    padding-bottom: 0.5rem;
    margin-bottom: 2rem;
  }

  .blog-index-tags-row {
    display: flex;
    gap: 0.5rem;
    min-width: max-content;
  }

  .blog-tag-button {
    font-family: var(--font-mono);
    font-size: clamp(0.72rem, 0.69rem + 0.12vw, 0.76rem);
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--dwc-border);
    color: var(--dwc-muted);
    background-color: transparent;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .blog-tag-button--active {
    border-color: var(--dwc-cyan);
    color: var(--dwc-navy);
    background-color: var(--dwc-cyan);
  }

  .blog-index-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .blog-index-empty {
    display: none;
    text-align: center;
    padding: 4rem 0;
  }

  @media (max-width: 520px) {
    .blog-index-grid {
      grid-template-columns: 1fr;
    }

    .blog-index-search {
      width: 100%;
    }
  }
</style>
