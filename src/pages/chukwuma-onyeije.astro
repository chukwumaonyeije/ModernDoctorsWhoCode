---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageUrl = 'https://www.doctorswhocode.blog/chukwuma-onyeije';
const personId = 'https://www.doctorswhocode.blog/about#person';
const imageUrl = 'https://www.doctorswhocode.blog/images/author-headshot.jpg';

const profileSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: 'Chukwuma Onyeije, MD, FACOG | Official Site and Profile',
      description:
        'Official profile page for Chukwuma Onyeije, MD, FACOG, an Atlanta maternal-fetal medicine specialist, physician-developer, and founder of Doctors Who Code.',
      mainEntity: {
        '@id': personId,
      },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: imageUrl,
      },
      isPartOf: {
        '@id': 'https://www.doctorswhocode.blog/#website',
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://www.doctorswhocode.blog/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Chukwuma Onyeije',
          item: pageUrl,
        },
      ],
    },
  ],
};

const quickLinks = [
  {
    label: 'Full profile',
    title: 'About Chukwuma Onyeije, MD, FACOG',
    href: '/about',
    copy: 'Clinical background, current work, projects, and the full physician-developer profile.',
  },
  {
    label: 'Writing',
    title: 'Doctors Who Code',
    href: '/blog',
    copy: 'Essays on AI in medicine, interoperability, clinical software, and physician-built systems.',
  },
  {
    label: 'Projects',
    title: 'CodeCraftMD and OpenMFM.org',
    href: '/about',
    copy: 'The physician-led documentation, billing, and MFM education work connected to the site.',
  },
];
---

<BaseLayout
  title="Chukwuma Onyeije, MD, FACOG | Official Site and Profile"
  description="Official site profile for Chukwuma Onyeije, MD, FACOG: Atlanta maternal-fetal medicine specialist, physician-developer, and founder of Doctors Who Code."
  canonical={pageUrl}
  ogImage="/images/author-headshot.jpg"
  ogType="profile"
  articleSchema={profileSchema}
>
  <div class="page-shell page-shell--narrow">
    <section class="profile-hero">
      <p class="label" style="margin-bottom: 0.75rem;">Official Site</p>
      <h1 class="gradient-text profile-title">Chukwuma Onyeije, MD, FACOG</h1>
      <p class="profile-kicker">
        Maternal-Fetal Medicine specialist, physician-developer, and founder of Doctors Who Code.
      </p>
      <p class="profile-copy">
        If you searched for Chukwuma Onyeije, Dr. Chukwuma Onyeije, or Chukwuma Onyeije MD,
        this is the official site profile. I practice maternal-fetal medicine in Atlanta,
        build physician-led AI and clinical software, and write about the case for doctors who build.
      </p>
      <div class="profile-actions">
        <a href="/about" class="site-button site-button--primary profile-action">Read the full profile</a>
        <a href="/blog" class="site-button site-button--secondary profile-action">Read the blog</a>
        <a href="/contact" class="site-button site-button--secondary profile-action">Subscribe</a>
      </div>
    </section>

    <section class="profile-grid">
      <div class="profile-card">
        <p class="label" style="margin-bottom: 0.5rem;">Clinical identity</p>
        <p class="profile-card-copy">
          Board-certified maternal-fetal medicine specialist in Atlanta, Georgia. High-risk obstetrics,
          physician judgment, and real workflow pressure shape how I evaluate technology.
        </p>
      </div>
      <div class="profile-card">
        <p class="label" style="margin-bottom: 0.5rem;">Builder identity</p>
        <p class="profile-card-copy">
          Physician-developer working on AI documentation, billing systems, interoperability,
          and clinical tools that belong closer to the bedside than the vendor demo.
        </p>
      </div>
      <div class="profile-card">
        <p class="label" style="margin-bottom: 0.5rem;">Public platforms</p>
        <p class="profile-card-copy">
          Doctors Who Code for writing, CodeCraftMD for physician-led AI systems,
          and OpenMFM.org for open maternal-fetal medicine education.
        </p>
      </div>
    </section>

    <section>
      <p class="label" style="margin-bottom: 0.75rem;">Start here</p>
      <div class="profile-links">
        {quickLinks.map((link) => (
          <a href={link.href} class="profile-link-card">
            <p class="label" style="margin-bottom: 0.5rem;">{link.label}</p>
            <h2 class="profile-link-title">{link.title}</h2>
            <p class="profile-card-copy">{link.copy}</p>
            <span class="profile-link-cta">Open &rarr;</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .profile-hero {
    margin-bottom: 3rem;
  }

  .profile-title {
    margin-bottom: 0.75rem;
    font-size: clamp(2rem, 1.45rem + 2vw, 2.6rem);
  }

  .profile-kicker {
    margin: 0 0 1rem;
    color: var(--dwc-cyan);
    font-family: var(--font-display);
    font-size: clamp(1.08rem, 0.98rem + 0.45vw, 1.25rem);
    line-height: 1.4;
  }

  .profile-copy,
  .profile-card-copy {
    margin: 0;
    color: var(--dwc-muted);
    line-height: 1.75;
    font-size: var(--font-size-body);
  }

  .profile-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .profile-action {
    width: auto;
  }

  .profile-grid,
  .profile-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .profile-grid {
    margin-bottom: 3rem;
  }

  .profile-card,
  .profile-link-card {
    background-color: var(--dwc-card);
    border: 1px solid var(--dwc-border);
    border-radius: 14px;
    padding: 1.25rem;
  }

  .profile-link-card {
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .profile-link-card:hover {
    transform: translateY(-2px);
    border-color: var(--dwc-blue);
  }

  .profile-link-title {
    margin: 0 0 0.6rem;
    font-size: clamp(1.05rem, 0.98rem + 0.35vw, 1.18rem);
    color: var(--dwc-white);
  }

  .profile-link-cta {
    display: inline-block;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: var(--dwc-cyan);
  }

  @media (max-width: 820px) {
    .profile-grid,
    .profile-links {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .profile-action {
      width: 100%;
    }
  }
</style>
