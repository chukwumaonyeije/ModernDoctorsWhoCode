---
interface Props {
  src: string;
  title: string;
}
const { src, title } = Astro.props;
---

<div class="audio-player-card">
  <button
    id="audio-play-btn"
    aria-label="Play article audio"
    aria-pressed="false"
    class="audio-play-button"
  >
    <svg id="icon-play" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="white"><polygon points="5,3 19,12 5,21"/></svg>
    <svg id="icon-pause" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="white" style="display:none;"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
  </button>

  <div class="audio-player-body">
    <p class="audio-player-label">Listen to this post</p>
    <p class="audio-player-title">{title}</p>
    <label class="sr-only" for="audio-progress-bar">Seek article audio</label>
    <input
      class="audio-progress-track"
      id="audio-progress-bar"
      type="range"
      min="0"
      max="100"
      value="0"
      step="0.1"
      aria-label="Seek article audio"
    />
  </div>

  <span id="audio-time" class="audio-player-time" aria-live="off">0:00 / 0:00</span>
</div>

<audio id="dwc-audio" src={src} preload="metadata" style="display: none;"></audio>

<script>
  const audio = document.getElementById('dwc-audio') as HTMLAudioElement;
  const playBtn = document.getElementById('audio-play-btn');
  const iconPlay = document.getElementById('icon-play');
  const iconPause = document.getElementById('icon-pause');
  const progressBar = document.getElementById('audio-progress-bar') as HTMLInputElement;
  const timeEl = document.getElementById('audio-time');

  function fmt(s: number) {
    const m = Math.floor(s / 60);
    const sec = Math.floor(s % 60).toString().padStart(2, '0');
    return `${m}:${sec}`;
  }

  playBtn?.addEventListener('click', () => {
    if (audio.paused) {
      audio.play();
      iconPlay!.style.display = 'none';
      iconPause!.style.display = 'block';
      playBtn.setAttribute('aria-label', 'Pause article audio');
      playBtn.setAttribute('aria-pressed', 'true');
    } else {
      audio.pause();
      iconPlay!.style.display = 'block';
      iconPause!.style.display = 'none';
      playBtn.setAttribute('aria-label', 'Play article audio');
      playBtn.setAttribute('aria-pressed', 'false');
    }
  });

  audio.addEventListener('loadedmetadata', () => {
    timeEl!.textContent = `0:00 / ${fmt(audio.duration)}`;
  });

  audio.addEventListener('timeupdate', () => {
    if (!audio.duration) return;
    const pct = (audio.currentTime / audio.duration) * 100;
    progressBar.value = String(pct);
    timeEl!.textContent = `${fmt(audio.currentTime)} / ${fmt(audio.duration)}`;
  });

  audio.addEventListener('ended', () => {
    iconPlay!.style.display = 'block';
    iconPause!.style.display = 'none';
    playBtn?.setAttribute('aria-label', 'Play article audio');
    playBtn?.setAttribute('aria-pressed', 'false');
    progressBar.value = '0';
    timeEl!.textContent = `0:00 / ${fmt(audio.duration)}`;
  });

  progressBar?.addEventListener('input', () => {
    if (!audio.duration) return;
    audio.currentTime = (Number(progressBar.value) / 100) * audio.duration;
  });
</script>

<style>
  .audio-player-card {
    background: var(--dwc-card);
    border: 1px solid var(--dwc-border);
    border-radius: 12px;
    padding: clamp(1rem, 0.85rem + 0.8vw, 1.5rem);
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .audio-play-button {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--dwc-blue);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .audio-player-body {
    flex: 1;
    min-width: 0;
  }

  .audio-player-label {
    margin: 0 0 0.25rem;
    font-family: var(--font-mono);
    font-size: clamp(0.7rem, 0.68rem + 0.1vw, 0.74rem);
    color: var(--dwc-cyan);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .audio-player-title {
    margin: 0;
    font-size: clamp(0.94rem, 0.9rem + 0.2vw, 1rem);
    line-height: 1.45;
    color: var(--dwc-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .audio-progress-track {
    appearance: none;
    width: 100%;
    margin-top: 0.6rem;
    height: 0.35rem;
    background: var(--dwc-border);
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    accent-color: var(--dwc-cyan);
  }

  .audio-progress-track::-webkit-slider-thumb {
    appearance: none;
    width: 1rem;
    height: 1rem;
    background: var(--dwc-cyan);
    border-radius: 50%;
  }

  .audio-progress-track::-moz-range-thumb {
    width: 1rem;
    height: 1rem;
    border: 0;
    background: var(--dwc-cyan);
    border-radius: 50%;
  }

  .audio-player-time {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: clamp(0.78rem, 0.75rem + 0.12vw, 0.82rem);
    color: var(--dwc-muted);
  }

  @media (max-width: 520px) {
    .audio-player-card {
      flex-wrap: wrap;
      align-items: flex-start;
    }

    .audio-player-time {
      margin-left: 3.4rem;
    }
  }
</style>
