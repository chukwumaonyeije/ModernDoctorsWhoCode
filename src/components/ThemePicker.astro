<label class="theme-picker" data-theme-picker hidden>
  <span>Theme</span>
  <select data-theme-control aria-label="Color theme">
    <option value="system">System</option>
    <option value="light">Light</option>
    <option value="dark">Dark</option>
  </select>
</label>

<style>
  .theme-picker:not([hidden]) { display: inline-flex; align-items: center; gap: 0.4rem; }
  .theme-picker { color: var(--color-muted); font-family: var(--font-mono); font-size: 0.75rem; }
  select { min-height: 2.75rem; max-width: 7rem; padding: 0.4rem; border: 1px solid var(--color-border); border-radius: var(--radius-control); color: var(--color-text); background: var(--color-surface); font: inherit; }
</style>
