---
import ThemePicker from './ThemePicker.astro';
const { pathname } = Astro.url;

const currentPath = `${pathname.replace(/\/+$/, '')}/`;
const learningLinks = [
  { label: 'Start Here', href: '/start/', active: currentPath.startsWith('/start/') },
  { label: 'Learning Paths', href: '/paths/', active: currentPath.startsWith('/paths/') },
  { label: 'Courses', href: '/courses/', active: currentPath.startsWith('/courses/') },
];
const links = [
  { label: 'Build', href: '/projects/', active: currentPath.startsWith('/projects/') },
  { label: 'Journal', href: '/blog/', active: currentPath.startsWith('/blog/') || currentPath.startsWith('/tags/') },
  { label: 'About', href: '/about/', active: pathname === '/about/' || pathname === '/about' },
];
---

<header class="site-header" data-site-header>
  <nav class="site-shell site-nav" aria-label="Primary navigation">
    <a href="/" class="site-nav-brand" aria-label="Doctors Who Code home">
      <span class="site-nav-mark" aria-hidden="true">DWC</span>
      <span class="site-nav-name">Doctors Who Code</span>
    </a>

    <button
      class="site-nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-navigation-links"
      data-nav-toggle
    >
      <span class="sr-only">Toggle navigation</span>
      <span class="site-nav-toggle-lines" aria-hidden="true"></span>
    </button>

    <div class="site-nav-panel" id="primary-navigation-links" data-nav-panel>
      <div class="site-nav-links">
        <details class="site-nav-learn" data-nav-learn>
          <summary class:list={['site-nav-link', { 'is-active': learningLinks.some(link => link.active) }]}>
            Learn <span class="site-nav-chevron" aria-hidden="true">⌄</span>
          </summary>
          <div class="site-nav-learning-links">
            {learningLinks.map(link => (
              <a href={link.href} class:list={['site-nav-link', { 'is-active': link.active }]}
                aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>
            ))}
          </div>
        </details>
        {links.map((link) => (
          <a
            href={link.href}
            class:list={['site-nav-link', { 'is-active': link.active }]}
            aria-current={currentPath === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}
      </div>

      <div class="site-nav-actions">
        <ThemePicker />
        <a href="/blog/#post-search" class="site-nav-search">Search</a>
        <a href="/contact/" class="site-button site-button--primary site-nav-cta">Subscribe</a>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  const header = document.querySelector('[data-site-header]');
  const toggle = header?.querySelector('[data-nav-toggle]');
  const panel = header?.querySelector('[data-nav-panel]');
  const learn = header?.querySelector('[data-nav-learn]');
  const learnSummary = learn?.querySelector('summary');

  if (header && toggle && panel) {
    header.dataset.enhanced = 'true';

    const setOpen = (open) => {
      header.dataset.open = open ? 'true' : 'false';
      toggle.setAttribute('aria-expanded', String(open));
      if (!open && learn) learn.open = false;
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    // Let Tab leave the menu normally without covering the newly focused content.
    header.addEventListener('focusout', (event) => {
      if (event.relatedTarget && !header.contains(event.relatedTarget)) setOpen(false);
    });

    learn?.addEventListener('focusout', (event) => {
      if (event.relatedTarget && !learn.contains(event.relatedTarget)) learn.open = false;
    });
    document.addEventListener('click', (event) => {
      if (learn && !learn.contains(event.target)) learn.open = false;
      if (!header.contains(event.target)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && learn?.open) {
        learn.open = false;
        learnSummary.focus();
        return;
      }
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    window.matchMedia('(min-width: 1321px)').addEventListener('change', (event) => {
      const focusInPanel = panel.contains(document.activeElement);
      if (event.matches) {
        if (learn?.contains(document.activeElement)) learnSummary.focus();
        setOpen(false);
        if (document.activeElement === toggle) learnSummary?.focus();
      } else if (focusInPanel) {
        setOpen(true);
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--dwc-border);
    background: rgba(var(--color-background-rgb), 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .site-nav {
    min-height: 4.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .site-nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    flex: 0 1 auto;
    min-width: 0;
    max-width: 100%;
    color: var(--dwc-white);
  }

  .site-nav-brand:hover {
    color: var(--dwc-white);
  }

  .site-nav-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.8rem;
    min-height: 1.9rem;
    padding: 0.2rem 0.45rem;
    border: 1px solid rgba(var(--color-accent-rgb), 0.34);
    border-radius: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--dwc-cyan);
    letter-spacing: 0.05em;
  }

  .site-nav-name {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 800;
    overflow-wrap: anywhere;
  }

  .site-nav-panel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    flex: 1;
    min-width: 0;
  }

  .site-nav-links,
  .site-nav-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  .site-nav-links {
    gap: 0.7rem;
  }

  .site-nav-actions {
    gap: 0.85rem;
  }

  .site-nav-learn { position: relative; }
  .site-nav-learn > summary { cursor: pointer; list-style: none; gap: 0.5rem; }
  .site-nav-learn > summary::-webkit-details-marker { display: none; }
  .site-nav-chevron { transition: transform 0.2s ease; }
  .site-nav-learn[open] .site-nav-chevron { transform: rotate(180deg); }
  .site-nav-learning-links {
    position: absolute;
    top: 100%;
    left: -0.75rem;
    min-width: 12rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--dwc-border);
    border-radius: 0.55rem;
    background: var(--dwc-card);
    box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.15);
  }
  .site-nav-learning-links .site-nav-link { display: flex; }

  .site-nav-link,
  .site-nav-search {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--dwc-muted);
    font-family: var(--font-mono);
    font-size: clamp(0.75rem, 0.72rem + 0.1vw, 0.8rem);
    line-height: 1.2;
    white-space: nowrap;
  }

  .site-nav-link:hover,
  .site-nav-link.is-active,
  .site-nav-search:hover {
    color: var(--dwc-white);
  }

  .site-nav-link.is-active::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0.35rem;
    left: 0;
    height: 2px;
    border-radius: 999px;
    background: var(--dwc-cyan);
  }

  .site-nav-search {
    padding-inline: 0.25rem;
  }

  .site-nav-cta {
    width: auto;
    min-height: 2.5rem;
    padding-inline: 0.9rem;
  }

  .site-nav-toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    margin-left: auto;
    padding: 0;
    border: 1px solid var(--dwc-border);
    border-radius: 0.55rem;
    background: var(--dwc-card);
    cursor: pointer;
  }

  .site-nav-toggle-lines,
  .site-nav-toggle-lines::before,
  .site-nav-toggle-lines::after {
    display: block;
    width: 1.15rem;
    height: 2px;
    margin-inline: auto;
    border-radius: 999px;
    background: var(--dwc-white);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .site-nav-toggle-lines {
    position: relative;
  }

  .site-nav-toggle-lines::before,
  .site-nav-toggle-lines::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .site-nav-toggle-lines::before { transform: translateY(-0.36rem); }
  .site-nav-toggle-lines::after { transform: translateY(0.36rem); }

  [data-open='true'] .site-nav-toggle-lines { background: transparent; }
  [data-open='true'] .site-nav-toggle-lines::before { transform: rotate(45deg); }
  [data-open='true'] .site-nav-toggle-lines::after { transform: rotate(-45deg); }

  @media (max-width: 1320px) {
    /* Keep expanded controls reachable at high zoom and in short landscape views. */
    .site-header {
      max-height: 100dvh;
      overflow-y: auto;
    }

    /* The always-open no-JS menu must not cover the page while it scrolls. */
    .site-header:not([data-enhanced='true']) {
      position: static;
      max-height: none;
      overflow: visible;
    }

    .site-nav {
      position: relative;
      min-height: 4rem;
      flex-wrap: wrap;
      padding-block: 0.55rem;
    }

    .site-nav-panel {
      flex-basis: 100%;
      align-items: stretch;
      flex-direction: column;
      gap: 0;
      padding-bottom: 0.75rem;
    }

    [data-enhanced='true'] .site-nav-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    [data-enhanced='true'] .site-nav-panel {
      display: none;
    }

    [data-enhanced='true'][data-open='true'] .site-nav-panel {
      display: flex;
    }

    .site-nav-links,
    .site-nav-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .site-nav-links {
      border-top: 1px solid var(--dwc-border);
    }

    .site-nav-learn > summary { display: flex; justify-content: space-between; }
    .site-nav-learning-links {
      position: static;
      min-width: 0;
      padding: 0 0 0 1rem;
      border: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }

    .site-nav-link,
    .site-nav-search {
      min-height: 2.9rem;
      padding: 0.7rem 0.15rem;
      border-bottom: 1px solid var(--dwc-border);
    }

    .site-nav-link.is-active::after {
      top: 0.75rem;
      right: auto;
      bottom: 0.75rem;
      left: -0.65rem;
      width: 2px;
      height: auto;
    }

    .site-nav-actions {
      gap: 0.75rem;
      padding-top: 0.75rem;
    }

    .site-nav-cta {
      width: 100%;
    }
  }

  @media (max-width: 420px) {
    .site-nav-name {
      font-size: 0.8rem;
    }
  }

  /* A tall enlarged header must be able to leave a short reading viewport. */
  @media (max-height: 480px) {
    .site-header { position: static; }
  }

  @media (max-width: 360px) {
    .site-nav-name { font-size: 0.7rem; }
    .site-nav { gap: 0.75rem; }
  }
</style>
