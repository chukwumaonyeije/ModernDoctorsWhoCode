---
const EMBED_ID = 'ae122d20-d362-4ced-ae4d-2f8ed8b5b273';
const SUBSCRIBE_URL = 'https://chukwumas-newsletter.beehiiv.com/subscribe';

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  note?: string;
  formHeading?: string;
  postSignupTitle?: string;
  postSignupCopy?: string;
  compact?: boolean;
}

const interestOptions = [
  'Learning to code as a physician',
  'Medical AI in practice',
  'Building clinical tools and apps',
] as const;

const trackResources: Record<(typeof interestOptions)[number], { heading: string; summary: string; downloads: { label: string; href: string }[] }> = {
  'Learning to code as a physician': {
    heading: 'Physician Coding Starter Pack',
    summary: 'A practical on-ramp for clinicians who want to move from curiosity to useful software.',
    downloads: [
      { label: 'Doctors Who Code Starter Guide', href: '/downloads/lead-magnets/series/physician-coding-starter-pack-01-doctors-who-code-starter-guide.pdf' },
      { label: 'GitHub for Physicians Quickstart', href: '/downloads/lead-magnets/series/physician-coding-starter-pack-02-github-for-physicians-quickstart.pdf' },
      { label: 'Medical App Ideas for Busy Clinicians', href: '/downloads/lead-magnets/series/physician-coding-starter-pack-03-medical-app-ideas-for-busy-clinicians.pdf' },
    ],
  },
  'Medical AI in practice': {
    heading: 'Medical AI for Doctors',
    summary: 'Frameworks for evaluating, validating, and deploying AI without surrendering clinical judgment.',
    downloads: [
      { label: 'Clinical AI Primer for Physicians', href: '/downloads/lead-magnets/series/medical-ai-for-doctors-01-clinical-ai-primer-for-physicians.pdf' },
      { label: 'AI Workflow Ideas for Medical Practices', href: '/downloads/lead-magnets/series/medical-ai-for-doctors-02-ai-workflow-ideas-for-medical-practices.pdf' },
      { label: 'Prompting Guide for Physician-Builders', href: '/downloads/lead-magnets/series/medical-ai-for-doctors-03-prompting-guide-for-physician-builders.pdf' },
    ],
  },
  'Building clinical tools and apps': {
    heading: 'Clinical App Builder Pack',
    summary: 'A builder’s path from workflow pain point to physician-led prototype and durable publishing loop.',
    downloads: [
      { label: 'Guideline-to-App Playbook', href: '/downloads/lead-magnets/series/clinical-app-builder-github-projects-01-guideline-to-app-playbook.pdf' },
      { label: 'Turn a Clinical Need Into a Small App', href: '/downloads/lead-magnets/series/clinical-app-builder-github-projects-02-how-to-turn-a-clinical-need-into-a-small-app.pdf' },
      { label: 'Astro + MDX + GitHub Workflow', href: '/downloads/lead-magnets/series/clinical-app-builder-github-projects-03-astro-mdx-github-workflow-for-physician-creators.pdf' },
    ],
  },
};

const {
  eyebrow = 'Newsletter',
  title = 'Join the physicians building what medicine actually needs.',
  subtitle = 'Subscribe for disciplined writing, practical resources, and onboarding tracks built around how you want to learn.',
  note = 'You will get focused essays, practical tools, and a clear onboarding path. No spam. No trend-chasing. Unsubscribe anytime.',
  formHeading = 'Choose your track',
  postSignupTitle = 'What happens after you subscribe',
  postSignupCopy = 'You will land in the right Beehiiv onboarding track, and you can also grab the matching starter resources immediately on this page.',
  compact = false,
} = Astro.props;

const instanceId = `newsletter-${Math.random().toString(36).slice(2, 10)}`;
---

<section
  class:list={['newsletter-card', { 'newsletter-card--compact': compact }]}
  aria-labelledby={`${instanceId}-signup-title`}
  data-newsletter-root
>
  <div class="newsletter-copy-column">
    <p class="label newsletter-eyebrow">{eyebrow}</p>
    <h2 id={`${instanceId}-signup-title`} class="newsletter-title">{title}</h2>
    <p class="newsletter-copy">{subtitle}</p>

    <div class="newsletter-interest-panel" aria-labelledby={`${instanceId}-interest-title`}>
      <p id={`${instanceId}-interest-title`} class="newsletter-interest-heading">{formHeading}</p>
      <ul class="newsletter-interest-list" aria-label="Primary interest options">
        {interestOptions.map((option) => (
          <li class="newsletter-interest-item">{option}</li>
        ))}
      </ul>
    </div>

    <p class="newsletter-note">{note}</p>
  </div>

  <div class="newsletter-form-column">
    <div class="newsletter-embed-shell">
      <p class="label newsletter-embed-label">Beehiiv Form</p>
      <div class="newsletter-embed-frame">
        <form class="beehiiv-embed" data-newsletter-form novalidate>
          <div class="beehiiv-embed__field">
            <label for={`${instanceId}-email`}>Email address</label>
            <input
              id={`${instanceId}-email`}
              type="email"
              name="email"
              placeholder="you@hospital.org"
              required
              autocomplete="email"
            />
          </div>

          <div class="beehiiv-embed__field">
            <label for={`${instanceId}-first-name`}>First name <span>(optional)</span></label>
            <input
              id={`${instanceId}-first-name`}
              type="text"
              name="first_name"
              placeholder="Chukwuma"
              autocomplete="given-name"
            />
          </div>

          <div class="beehiiv-embed__field">
            <label for={`${instanceId}-interest`}>Primary interest</label>
            <select id={`${instanceId}-interest`} name="primary_interest" required>
              <option value="">Select one</option>
              {interestOptions.map((option) => (
                <option value={option}>{option}</option>
              ))}
            </select>
          </div>

          <p class="newsletter-resource-note">
            Choose a track and subscribe. You will get the matching Beehiiv sequence plus immediate access to the starter bundle below.
          </p>

          <button type="submit" class="site-button site-button--primary beehiiv-embed__button" data-newsletter-submit>
            Subscribe
          </button>

          <p class="newsletter-form-status" data-newsletter-status aria-live="polite"></p>
        </form>

        <div class="newsletter-success-panel" data-newsletter-success hidden>
          <p class="label newsletter-success-label">Starter Bundle</p>
          <h3 class="newsletter-success-title" data-newsletter-success-title></h3>
          <p class="newsletter-success-copy" data-newsletter-success-copy></p>
          <div class="newsletter-success-links" data-newsletter-success-links></div>
        </div>

        <noscript>
          <p class="newsletter-dev-note">
            JavaScript is off. Subscribe directly on Beehiiv:
            <a href={SUBSCRIBE_URL} target="_blank" rel="noopener noreferrer" class="newsletter-inline-link">open the hosted subscribe page</a>.
          </p>
        </noscript>
      </div>
    </div>

    <div class="newsletter-postsignup-note" aria-labelledby={`${instanceId}-postsignup-title`}>
      <p class="label newsletter-postsignup-label">Onboarding</p>
      <h3 id={`${instanceId}-postsignup-title`} class="newsletter-postsignup-title">{postSignupTitle}</h3>
      <p class="newsletter-postsignup-copy">{postSignupCopy}</p>
    </div>
  </div>
</section>

<script define:vars={{ EMBED_ID, SUBSCRIBE_URL, trackResources }}>
  const roots = document.querySelectorAll('[data-newsletter-root]');

  roots.forEach((root) => {
    const form = root.querySelector('[data-newsletter-form]');
    const emailInput = root.querySelector('input[name="email"]');
    const firstNameInput = root.querySelector('input[name="first_name"]');
    const interestInput = root.querySelector('select[name="primary_interest"]');
    const submitButton = root.querySelector('[data-newsletter-submit]');
    const status = root.querySelector('[data-newsletter-status]');
    const successPanel = root.querySelector('[data-newsletter-success]');
    const successTitle = root.querySelector('[data-newsletter-success-title]');
    const successCopy = root.querySelector('[data-newsletter-success-copy]');
    const successLinks = root.querySelector('[data-newsletter-success-links]');

    if (!form || !emailInput || !firstNameInput || !interestInput || !submitButton || !status || !successPanel || !successTitle || !successCopy || !successLinks) {
      return;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const email = emailInput.value.trim();
      const firstName = firstNameInput.value.trim();
      const primaryInterest = interestInput.value;

      if (!email || !primaryInterest) {
        status.textContent = 'Add your email and choose a track first.';
        status.style.color = 'var(--dwc-muted)';
        successPanel.hidden = true;
        return;
      }

      submitButton.textContent = 'Sending...';
      submitButton.setAttribute('disabled', 'disabled');
      status.textContent = '';
      successPanel.hidden = true;

      const selectedTrack = trackResources[primaryInterest];
      const payload = {
        email,
        first_name: firstName || undefined,
        primary_interest: primaryInterest,
        reactivate_existing: true,
        send_welcome_email: true,
        referring_site: window.location.href,
        utm_source: 'doctorswhocode.blog',
        utm_medium: 'site-form',
        utm_campaign: primaryInterest.toLowerCase().replace(/\s+/g, '-'),
      };

      try {
        const response = await fetch(`https://embeds.beehiiv.com/${EMBED_ID}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (!response.ok && response.status !== 201) {
          throw new Error('Subscription failed');
        }

        status.textContent = 'You are subscribed. Your first track-specific email is on the way.';
        status.style.color = 'var(--dwc-cyan)';

        if (selectedTrack) {
          successTitle.textContent = selectedTrack.heading;
          successCopy.textContent = selectedTrack.summary;
          successLinks.innerHTML = selectedTrack.downloads
            .map((download) => `<a class="site-button site-button--secondary newsletter-download-link" href="${download.href}" target="_blank" rel="noopener noreferrer">${download.label}</a>`)
            .join('');
          successPanel.hidden = false;
        }

        form.reset();
      } catch (error) {
        status.textContent = 'Redirecting to the hosted Beehiiv subscribe page...';
        status.style.color = 'var(--dwc-muted)';
        const fallbackUrl = new URL(SUBSCRIBE_URL);
        fallbackUrl.searchParams.set('email', email);
        if (firstName) {
          fallbackUrl.searchParams.set('first_name', firstName);
        }
        fallbackUrl.searchParams.set('utm_source', 'doctorswhocode.blog');
        fallbackUrl.searchParams.set('utm_medium', 'site-form');
        fallbackUrl.searchParams.set('utm_campaign', primaryInterest.toLowerCase().replace(/\s+/g, '-'));
        window.location.assign(fallbackUrl.toString());
      } finally {
        submitButton.textContent = 'Subscribe';
        submitButton.removeAttribute('disabled');
      }
    });
  });
</script>

<style>
  .newsletter-card {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(1.25rem, 1rem + 1vw, 2rem);
    background:
      radial-gradient(circle at top right, rgba(56, 189, 248, 0.12), transparent 34%),
      linear-gradient(180deg, rgba(15, 18, 25, 0.96), rgba(10, 13, 26, 0.98));
    border: 1px solid rgba(56, 189, 248, 0.12);
    border-radius: 18px;
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    box-shadow: 0 18px 54px rgba(0, 0, 0, 0.24);
  }

  .newsletter-card--compact {
    grid-template-columns: 1fr;
  }

  .newsletter-copy-column,
  .newsletter-form-column {
    min-width: 0;
  }

  .newsletter-eyebrow {
    margin-bottom: 0.75rem;
  }

  .newsletter-title {
    font-size: clamp(1.45rem, 1.2rem + 1vw, 2rem);
    margin-bottom: 0.75rem;
    max-width: 16ch;
  }

  .newsletter-copy,
  .newsletter-note,
  .newsletter-postsignup-copy,
  .newsletter-resource-note,
  .newsletter-success-copy {
    margin: 0;
    color: var(--dwc-muted);
    font-size: clamp(0.98rem, 0.95rem + 0.18vw, 1rem);
    line-height: 1.7;
  }

  .newsletter-copy {
    margin-bottom: 1.25rem;
    max-width: 52ch;
  }

  .newsletter-interest-panel,
  .newsletter-postsignup-note,
  .newsletter-embed-shell {
    border: 1px solid var(--dwc-border);
    border-radius: 14px;
    background: rgba(10, 13, 26, 0.72);
  }

  .newsletter-interest-panel {
    padding: 1rem;
    margin-bottom: 1rem;
  }

  .newsletter-interest-heading,
  .newsletter-postsignup-title,
  .newsletter-success-title {
    margin: 0 0 0.65rem;
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.1rem);
    line-height: 1.3;
    color: var(--dwc-white);
  }

  .newsletter-interest-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.65rem;
  }

  .newsletter-interest-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3rem;
    padding: 0.8rem 0.95rem;
    border-radius: 10px;
    background: rgba(56, 189, 248, 0.07);
    border: 1px solid rgba(56, 189, 248, 0.14);
    color: var(--dwc-white);
    font-size: clamp(0.94rem, 0.92rem + 0.14vw, 0.98rem);
    line-height: 1.45;
  }

  .newsletter-interest-item::before {
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--dwc-cyan);
    flex: 0 0 auto;
    box-shadow: 0 0 18px rgba(56, 189, 248, 0.4);
  }

  .newsletter-note {
    max-width: 54ch;
  }

  .newsletter-embed-shell {
    padding: 1rem;
  }

  .newsletter-embed-label,
  .newsletter-postsignup-label,
  .newsletter-success-label {
    margin-bottom: 0.6rem;
  }

  .newsletter-embed-frame {
    border-radius: 12px;
    border: 1px dashed rgba(56, 189, 248, 0.22);
    background: rgba(15, 18, 25, 0.92);
    padding: 1rem;
  }

  .newsletter-postsignup-note {
    margin-top: 0.9rem;
    padding: 1rem;
  }

  .newsletter-dev-note,
  .newsletter-form-status {
    margin: 0;
    color: var(--dwc-muted);
    font-family: var(--font-mono);
    font-size: clamp(0.76rem, 0.74rem + 0.12vw, 0.82rem);
    line-height: 1.55;
  }

  .newsletter-form-status {
    min-height: 1.25rem;
  }

  .newsletter-success-panel {
    margin-top: 1rem;
    border: 1px solid rgba(56, 189, 248, 0.14);
    border-radius: 12px;
    background: rgba(56, 189, 248, 0.07);
    padding: 1rem;
  }

  .newsletter-success-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .newsletter-download-link {
    width: auto;
  }

  :global(.beehiiv-embed) {
    display: grid;
    gap: 0.85rem;
  }

  :global(.beehiiv-embed label) {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    margin-bottom: 0.45rem;
    font-family: var(--font-mono);
    font-size: clamp(0.76rem, 0.73rem + 0.12vw, 0.82rem);
    line-height: 1.4;
    letter-spacing: 0.02em;
    color: var(--dwc-cyan);
  }

  :global(.beehiiv-embed label span) {
    color: var(--dwc-muted);
  }

  :global(.beehiiv-embed input),
  :global(.beehiiv-embed select),
  :global(.beehiiv-embed textarea) {
    width: 100%;
    min-height: 2.9rem;
    padding: 0.8rem 0.95rem;
    border-radius: 10px;
    border: 1px solid var(--dwc-border);
    background: var(--dwc-card);
    color: var(--dwc-white);
    font-family: var(--font-mono);
    font-size: var(--font-size-control);
    line-height: 1.35;
  }

  :global(.beehiiv-embed select) {
    appearance: none;
  }

  :global(.beehiiv-embed input::placeholder) {
    color: color-mix(in srgb, var(--dwc-muted) 88%, white 12%);
  }

  :global(.beehiiv-embed button),
  :global(.beehiiv-embed [type='submit']) {
    width: 100%;
    justify-content: center;
  }

  .newsletter-inline-link {
    color: var(--dwc-muted);
    text-decoration: underline;
  }

  @media (max-width: 820px) {
    .newsletter-card {
      grid-template-columns: 1fr;
    }

    .newsletter-title {
      max-width: 20ch;
    }
  }

  @media (max-width: 520px) {
    .newsletter-card,
    .newsletter-interest-panel,
    .newsletter-embed-shell,
    .newsletter-postsignup-note,
    .newsletter-embed-frame {
      padding-inline: 1rem;
    }

    .newsletter-success-links {
      flex-direction: column;
    }

    .newsletter-download-link {
      width: 100%;
    }
  }
</style>
