---
const EMBED_ID = 'ae122d20-d362-4ced-ae4d-2f8ed8b5b273';

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = 'Physicians who build, delivered weekly.',
  subtitle = 'Clinical insights + developer tools for the physician-coder. No hype. No filler.',
} = Astro.props;
---

<div class="newsletter-card">
  <p class="label" style="margin-bottom: 0.5rem;">Newsletter</p>
  <h3 class="newsletter-title">{title}</h3>
  <p class="newsletter-copy">{subtitle}</p>

  <form id="newsletter-form" class="newsletter-form">
    <input
      id="newsletter-email"
      type="email"
      placeholder="Enter your email"
      required
      class="newsletter-input"
    />
    <button
      type="submit"
      id="newsletter-btn"
      class="newsletter-button"
    >Subscribe</button>
  </form>

  <p id="newsletter-msg" class="newsletter-message"></p>

  <p class="newsletter-powered-by">
    Powered by <a href="https://beehiiv.com" target="_blank" rel="noopener" class="newsletter-inline-link">beehiiv</a>
  </p>
</div>

<script define:vars={{ EMBED_ID }}>
  const form = document.getElementById('newsletter-form');
  const emailInput = document.getElementById('newsletter-email');
  const btn = document.getElementById('newsletter-btn');
  const msg = document.getElementById('newsletter-msg');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = emailInput?.value?.trim();
    if (!email) return;

    btn.textContent = 'Sending...';
    btn.disabled = true;
    msg.style.color = 'var(--dwc-muted)';
    msg.textContent = '';

    try {
      const res = await fetch(`https://embeds.beehiiv.com/${EMBED_ID}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });

      if (res.ok || res.status === 201) {
        msg.style.color = 'var(--dwc-cyan)';
        msg.textContent = 'You are in. Welcome to the physician-developer community.';
        form.reset();
      } else {
        throw new Error('Bad response');
      }
    } catch {
      // Fallback: redirect to hosted Beehiiv subscribe page
      msg.style.color = 'var(--dwc-muted)';
      msg.innerHTML = 'Redirecting to subscribe page...';
      setTimeout(() => {
        window.open('https://chukwumas-newsletter.beehiiv.com/subscribe?email=' + encodeURIComponent(email), '_blank');
      }, 600);
    } finally {
      btn.textContent = 'Subscribe';
      btn.disabled = false;
    }
  });
</script>

<style>
  .newsletter-card {
    background-color: var(--dwc-card);
    border: 1px solid var(--dwc-border);
    border-radius: 12px;
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    text-align: center;
  }

  .newsletter-title {
    font-size: clamp(1.25rem, 1.1rem + 0.55vw, 1.45rem);
    margin-bottom: 0.5rem;
  }

  .newsletter-copy {
    margin: 0 auto 1.5rem;
    font-size: clamp(0.98rem, 0.95rem + 0.18vw, 1rem);
    line-height: 1.65;
    color: var(--dwc-muted);
    max-width: 48ch;
  }

  .newsletter-form {
    display: flex;
    max-width: 480px;
    margin: 0 auto 0.75rem;
  }

  .newsletter-input {
    flex: 1;
    background: var(--dwc-navy);
    border: 1px solid var(--dwc-border);
    border-right: none;
    border-radius: 8px 0 0 8px;
    padding: 0.75rem 1rem;
    font-family: var(--font-mono);
    font-size: var(--font-size-control);
    color: var(--dwc-white);
    outline: none;
  }

  .newsletter-button {
    border: none;
    border-radius: 0 8px 8px 0;
    padding: 0.75rem 1.25rem;
    background: var(--dwc-blue);
    color: var(--dwc-white);
    font-family: var(--font-mono);
    font-size: var(--font-size-button);
    line-height: 1.2;
    cursor: pointer;
    white-space: nowrap;
  }

  .newsletter-message {
    min-height: 1.25rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(0.82rem, 0.8rem + 0.12vw, 0.88rem);
    line-height: 1.45;
  }

  .newsletter-powered-by {
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: clamp(0.72rem, 0.7rem + 0.1vw, 0.76rem);
    line-height: 1.45;
    color: var(--dwc-muted);
  }

  .newsletter-inline-link {
    color: var(--dwc-muted);
    text-decoration: underline;
  }

  @media (max-width: 520px) {
    .newsletter-form {
      flex-direction: column;
      gap: 0.75rem;
    }

    .newsletter-input {
      border-right: 1px solid var(--dwc-border);
      border-radius: 8px;
    }

    .newsletter-button {
      border-radius: 8px;
    }
  }
</style>
