---
import type { CollectionEntry } from 'astro:content';

interface Props {
  path: CollectionEntry<'paths'>;
  courseCount: number;
  lessonCount: number;
  estimatedMinutes: number;
  prompt?: string;
}

const { path, courseCount, lessonCount, estimatedMinutes, prompt } = Astro.props;
const marks = {
  code: '{ }',
  ai: 'AI',
  software: 'Rx',
};
---

<a href={`/paths/${path.id}/`} class="learning-path-card">
  <article>
    <div class="learning-path-card-topline">
      <span class="learning-path-mark" aria-hidden="true">{marks[path.data.icon]}</span>
      <span class="label">Path {path.data.order}</span>
    </div>

    {prompt && <p class="learning-path-prompt">{prompt}</p>}
    <h3>{path.data.title}</h3>
    <p class="learning-path-description">{path.data.description}</p>

    <dl class="learning-path-meta">
      <div>
        <dt>For</dt>
        <dd>{path.data.audience}</dd>
      </div>
      <div>
        <dt>Outcome</dt>
        <dd>{path.data.outcome}</dd>
      </div>
    </dl>

    <div class="learning-path-footer">
      <span>{courseCount} {courseCount === 1 ? 'course' : 'courses'}</span>
      <span>{lessonCount} {lessonCount === 1 ? 'lesson' : 'lessons'}</span>
      <span>{estimatedMinutes} min</span>
      <strong>View path <span aria-hidden="true">→</span></strong>
    </div>
  </article>
</a>

<style>
  .learning-path-card {
    display: block;
    height: 100%;
    color: inherit;
  }

  .learning-path-card:hover {
    color: inherit;
  }

  article {
    height: 100%;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border: 1px solid var(--dwc-border);
    border-radius: 1rem;
    background:
      radial-gradient(circle at top right, rgba(56, 189, 248, 0.09), transparent 34%),
      var(--dwc-card);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .learning-path-card:hover article {
    border-color: rgba(56, 189, 248, 0.55);
    transform: translateY(-2px);
  }

  .learning-path-card-topline,
  .learning-path-footer {
    display: flex;
    align-items: center;
  }

  .learning-path-card-topline {
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .learning-path-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid rgba(56, 189, 248, 0.3);
    border-radius: 0.65rem;
    background: rgba(56, 189, 248, 0.07);
    color: var(--dwc-cyan);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .learning-path-prompt {
    min-height: 2.8rem;
    margin: 0 0 0.75rem;
    color: var(--dwc-cyan);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.45;
  }

  h3 {
    margin-bottom: 0.75rem;
    font-size: clamp(1.35rem, 1.15rem + 0.8vw, 1.65rem);
  }

  .learning-path-description {
    min-height: 5rem;
    margin-bottom: 1.25rem;
    color: var(--dwc-muted);
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .learning-path-meta {
    display: grid;
    gap: 0.85rem;
    margin: 0;
  }

  .learning-path-meta div {
    padding-top: 0.85rem;
    border-top: 1px solid var(--dwc-border);
  }

  dt {
    margin-bottom: 0.25rem;
    color: var(--dwc-cyan);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  dd {
    margin: 0;
    color: var(--dwc-white);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .learning-path-footer {
    flex-wrap: wrap;
    gap: 0.5rem 0.8rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--dwc-border);
    color: var(--dwc-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .learning-path-footer strong {
    margin-left: auto;
    color: var(--dwc-cyan);
    font-weight: 500;
  }

  @media (max-width: 480px) {
    .learning-path-description {
      min-height: 0;
    }

    .learning-path-footer strong {
      width: 100%;
      margin: 0.25rem 0 0;
    }
  }
</style>
