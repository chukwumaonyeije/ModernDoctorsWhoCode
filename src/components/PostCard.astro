---
import FormattedDate from './FormattedDate.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  tags?: string[];
  category?: string;
  readingTime?: number;
  image?: { url: string; alt: string };
  featured?: boolean;
}

const {
  title,
  description,
  pubDate,
  slug,
  tags = [],
  category = 'Technology',
  readingTime,
  image,
  featured = false,
} = Astro.props;
---

<a href={`/blog/${slug}`} class="post-card-link">
  <article class="card post-card">
    {image && (
      <img
        src={image.url}
        alt={image.alt}
        class="post-card-image"
      />
    )}

    <div class="post-card-meta">
      <span class="label">{category}</span>
      {featured && (
        <span class="post-card-badge">Featured</span>
      )}
    </div>

    <h3 class="gradient-text post-card-title">{title}</h3>
    <p class="post-card-description">{description}</p>

    <div class="post-card-date-row">
      <span class="eyebrow-copy">
        <FormattedDate date={pubDate} />
      </span>
      {readingTime && (
        <>
          <span class="post-card-separator">&middot;</span>
          <span class="eyebrow-copy">{readingTime} min read</span>
        </>
      )}
    </div>

    {tags.length > 0 && (
      <div class="post-card-tags">
        {tags.slice(0, 3).map(tag => (
          <span class="tag-pill post-card-tag">{tag}</span>
        ))}
      </div>
    )}
  </article>
</a>

<style>
  .post-card-link {
    display: block;
    text-decoration: none;
  }

  .post-card {
    padding: clamp(1rem, 0.8rem + 0.8vw, 1.5rem);
    height: 100%;
  }

  .post-card-image {
    width: 100%;
    height: clamp(180px, 34vw, 220px);
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 1rem;
    border: 1px solid var(--dwc-border);
  }

  .post-card-meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .post-card-badge {
    font-family: var(--font-mono);
    font-size: clamp(0.68rem, 0.66rem + 0.1vw, 0.72rem);
    color: var(--dwc-navy);
    background-color: var(--dwc-cyan);
    padding: 0.18rem 0.5rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .post-card-title {
    font-size: clamp(1.18rem, 1.08rem + 0.45vw, 1.3rem);
    margin-bottom: 0.6rem;
    line-height: 1.25;
  }

  .post-card-description {
    font-size: clamp(0.96rem, 0.92rem + 0.2vw, 1rem);
    color: var(--dwc-muted);
    margin-bottom: 1rem;
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-date-row {
    display: flex;
    align-items: center;
    gap: 0.4rem 0.75rem;
    flex-wrap: wrap;
    margin-top: auto;
  }

  .post-card-separator {
    color: var(--dwc-border);
  }

  .post-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 1rem;
  }

  .post-card-tag {
    font-size: clamp(0.68rem, 0.66rem + 0.1vw, 0.72rem);
    padding: 0.15rem 0.5rem;
  }

  .post-card-link:hover article {
    transform: translateY(-2px);
    border-color: var(--dwc-blue);
  }
  article {
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
</style>
