---
interface SeriesPost {
  label: string;
  href: string;
  current?: boolean;
}

interface Props {
  current?: number;
  posts: SeriesPost[];
  title?: string;
}

const { current, posts = [], title = 'Series Navigation' } = Astro.props;

const activeIndexFromPosts = posts.findIndex((post) => post.current);
const activeIndex = activeIndexFromPosts >= 0 ? activeIndexFromPosts : Math.max(0, current ?? 0);
const previousPost = activeIndex > 0 ? posts[activeIndex - 1] : undefined;
const nextPost = activeIndex < posts.length - 1 ? posts[activeIndex + 1] : undefined;
---

{posts.length > 0 && (
  <nav class="card series-nav" aria-label="Series navigation">
    <div class="series-nav-header">
      <p class="label">{title}</p>
      <p class="series-nav-progress">
        Post {activeIndex + 1} of {posts.length}
      </p>
    </div>

    <div class="series-nav-links">
      {posts.map((post, index) => (
        <a
          href={post.href}
          class:list={['series-nav-link', { 'is-current': index === activeIndex || post.current }]}
          aria-current={index === activeIndex || post.current ? 'page' : undefined}
        >
          <span class="series-nav-index">{index + 1}</span>
          <span>{post.label}</span>
        </a>
      ))}
    </div>

    <div class="series-nav-footer">
      {previousPost ? (
        <a href={previousPost.href} class="series-nav-cta">
          Previous: {previousPost.label}
        </a>
      ) : (
        <span class="series-nav-cta is-muted">Start of series</span>
      )}

      {nextPost ? (
        <a href={nextPost.href} class="series-nav-cta">
          Next: {nextPost.label}
        </a>
      ) : (
        <span class="series-nav-cta is-muted">End of series</span>
      )}
    </div>
  </nav>
)}

<style>
  .series-nav {
    margin: 2.5rem 0 1rem;
    padding: 1.25rem;
  }

  .series-nav-header,
  .series-nav-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .series-nav-progress {
    margin: 0;
    color: var(--dwc-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .series-nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin: 1rem 0 1.25rem;
  }

  .series-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--dwc-border);
    border-radius: 999px;
    text-decoration: none;
    color: var(--dwc-text);
    background: rgba(255, 255, 255, 0.02);
    transition: border-color 0.2s ease, transform 0.2s ease, color 0.2s ease;
    font-size: 0.9rem;
    line-height: 1.2;
  }

  .series-nav-link:hover {
    border-color: var(--dwc-blue);
    transform: translateY(-1px);
  }

  .series-nav-link.is-current {
    border-color: var(--dwc-cyan);
    color: var(--dwc-navy);
    background: var(--dwc-cyan);
  }

  .series-nav-index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .series-nav-link.is-current .series-nav-index {
    background: rgba(3, 18, 36, 0.12);
  }

  .series-nav-cta {
    color: var(--dwc-cyan);
    text-decoration: none;
    font-size: 0.92rem;
  }

  .series-nav-cta:hover {
    text-decoration: underline;
  }

  .series-nav-cta.is-muted {
    color: var(--dwc-muted);
  }

  @media (max-width: 720px) {
    .series-nav-footer {
      flex-direction: column;
      align-items: flex-start;
    }

    .series-nav-link {
      width: 100%;
      justify-content: flex-start;
      border-radius: 14px;
    }
  }
</style>
